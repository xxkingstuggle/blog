---
import { siteConfig } from '../config';

interface Props {
	isHeroPage?: boolean;
}

const { isHeroPage = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="site-header" id="site-header" data-theme={isHeroPage ? 'dark-hero' : 'default'}>
	<div class="shell header-inner">
		<a class="brand" href="/" aria-label={`${siteConfig.name} 首页`}>
			<span class="brand-mark" aria-hidden="true">✳</span>
			<span>{siteConfig.name}</span>
		</a>
		<nav class="site-nav" aria-label="主导航">
			<a href="/posts/" aria-current={currentPath.startsWith('/posts') ? 'page' : undefined}>发布</a>
			<a href="/#projects">项目</a>
			<a href="/about/" aria-current={currentPath.startsWith('/about') ? 'page' : undefined}>关于</a>
		</nav>
	</div>
</header>

{isHeroPage && (
	<script>
		// Adapt header theme when scrolling past dark hero
		const header = document.getElementById('site-header');
		const hero = document.getElementById('hero');

		if (header && hero) {
			const observer = new IntersectionObserver(
				([entry]) => {
					if (entry.isIntersecting) {
						header.setAttribute('data-theme', 'dark-hero');
					} else {
						header.removeAttribute('data-theme');
					}
				},
				{ threshold: 0.1 }
			);
			observer.observe(hero);
		}
	</script>
)}
