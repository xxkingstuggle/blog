---
import { SOFTWARE_PRODUCTS } from '../lib/software';
import ThemeSwitcher from './ThemeSwitcher.astro';

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
const isSoftware = currentPath.startsWith('/software');
const isPosts = currentPath.startsWith('/posts') || currentPath.startsWith('/archive') || currentPath.startsWith('/tags');
const isAbout = currentPath.startsWith('/about') || currentPath.startsWith('/links');
---

<header class="site-header" id="site-header">
	<div class="shell header-inner">
		<a class="brand" href="/" aria-label="Xin · myzjx.com 首页">
			<span class="brand-monogram" aria-hidden="true">X</span>
			<span class="brand-identity">
				<span class="brand-name">MYZJX</span>
				<span class="brand-domain">myzjx.com</span>
			</span>
		</a>

		<nav class="site-nav" aria-label="主导航">
			<a href="/" aria-current={isHome ? 'page' : undefined}>首页</a>
			<a href="/software/" aria-current={isSoftware ? 'page' : undefined}>软件与工具</a>
			<a href="/posts/" aria-current={isPosts ? 'page' : undefined}>文章与手记</a>
			<a href="/about/" aria-current={isAbout ? 'page' : undefined}>关于</a>
		</nav>

		<div class="header-actions">
			<a class="header-cta" href="/software/usblinkmic/">
				<span>获取 USBLinkMic</span>
				<span class="header-cta-badge">{SOFTWARE_PRODUCTS[0].latestVersion}</span>
			</a>
			<ThemeSwitcher />
			<details class="mobile-nav" data-mobile-nav>
				<summary class="mobile-nav-trigger" aria-label="站点导航菜单" aria-controls="mobile-nav-panel">
					<span class="mobile-nav-bars" aria-hidden="true">
						<span></span>
						<span></span>
					</span>
					<span class="mobile-nav-label">菜单</span>
				</summary>
				<div class="mobile-nav-panel" id="mobile-nav-panel" role="dialog" aria-label="站点导航">
					<nav class="mobile-nav-links" aria-label="移动端主导航">
						<a href="/" aria-current={isHome ? 'page' : undefined}>
							<strong>首页</strong>
							<span>个人品牌、代表软件与近期手记</span>
						</a>
						<a href="/software/" aria-current={isSoftware ? 'page' : undefined}>
							<strong>软件与工具</strong>
							<span>公开作品、个人原型与工程实践</span>
						</a>
						<a href="/posts/" aria-current={isPosts ? 'page' : undefined}>
							<strong>文章与手记</strong>
							<span>工程复盘、技术实践与思考记录</span>
						</a>
						<a href="/about/" aria-current={isAbout ? 'page' : undefined}>
							<strong>关于 Xin</strong>
							<span>我在做什么、工作方法与联系方式</span>
						</a>
					</nav>
					<div class="mobile-nav-sub">
						<a href="/archive/">时间归档</a>
						<a href="/tags/">标签索引</a>
						<a href="/links/">友链推荐</a>
						<a href="/rss.xml">RSS 订阅</a>
					</div>
				</div>
			</details>
		</div>
	</div>
</header>
