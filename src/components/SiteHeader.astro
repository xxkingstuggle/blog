---
import { SOFTWARE_PRODUCTS } from '../lib/software';
import ThemeSwitcher from './ThemeSwitcher.astro';

const path = Astro.url.pathname;
const isHome = path === '/';
const isWork = path.startsWith('/software');
const isPosts = path.startsWith('/posts') || path.startsWith('/tags') || path.startsWith('/archive');
const isAbout = path.startsWith('/about') || path.startsWith('/links');
const items = [
  { href: '/', label: '精选', sub: 'Overview', icon: '▦', current: isHome },
  { href: '/software/', label: '作品', sub: 'Projects', icon: '◫', current: isWork },
  { href: '/posts/', label: '文章', sub: 'Journal', icon: '▤', current: isPosts },
  { href: '/about/', label: '关于', sub: 'About', icon: '◉', current: isAbout },
];
---
<header class="site-header studio-side-rail" id="site-header">
  <a class="studio-rail-brand" href="/" aria-label="MYZJX 首页">
    <span class="studio-brand-symbol" aria-hidden="true">X<span>.</span></span>
    <span class="studio-brand-label"><strong>MYZJX</strong><small>Design & Engineering</small></span>
  </a>
  <div class="studio-rail-content">
    <div class="studio-rail-section-label">EXPLORE <span>01</span></div>
    <nav class="studio-primary-nav" aria-label="主导航">
      {items.map((item) => (
        <a href={item.href} aria-current={item.current ? 'page' : undefined}>
          <span class="studio-nav-icon" aria-hidden="true">{item.icon}</span>
          <span>{item.label}</span>
          <span class="studio-nav-sub">{item.sub}</span>
        </a>
      ))}
    </nav>
    <div class="studio-rail-section-label studio-rail-section-label--collections">COLLECTIONS <span>02</span></div>
    <nav class="studio-secondary-nav" aria-label="其他分类">
      <a href="/archive/"><span aria-hidden="true">◷</span> 时间归档</a>
      <a href="/tags/"><span aria-hidden="true">⌗</span> 文章标签</a>
      <a href="/links/"><span aria-hidden="true">↗</span> 站点收藏</a>
    </nav>
    <div class="studio-rail-spacer"></div>
    <a class="studio-sidebar-feature" href="/software/usblinkmic/">
      <span class="studio-sidebar-feature-label">FEATURED WORK <span aria-hidden="true">↗</span></span>
      <span class="studio-sidebar-feature-title">USBLinkMic</span>
      <small>v{SOFTWARE_PRODUCTS[0].latestVersion.replace(/^v/i, '')} · macOS & Android</small>
    </a>
  </div>
  <div class="studio-rail-bottom">
    <span class="studio-rail-bottom-label">APPEARANCE</span>
    <ThemeSwitcher />
    <a href="/login/" class="studio-admin-access" title="私人管理后台"><span aria-hidden="true">⌁</span> 管理后台 <span aria-hidden="true">↗</span></a>
  </div>
</header>
<nav class="studio-mobile-dock" aria-label="手机端主导航">
  {items.map((item) => (
    <a href={item.href} aria-current={item.current ? 'page' : undefined}>
      <span aria-hidden="true">{item.icon}</span><small>{item.label}</small>
    </a>
  ))}
</nav>
