---
import ThemeSwitcher from './ThemeSwitcher.astro';
const currentPath = Astro.url.pathname;
---
<header class="site-header" id="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Xin 首页"><span class="brand-mark" aria-hidden="true">x.</span><span class="brand-name">Xin<span class="brand-divider"> / </span><span class="brand-caption">随手记</span></span></a>
    <nav class="site-nav" aria-label="主导航">
      <a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>首页</a>
      <a href="/posts/" aria-current={currentPath.startsWith('/posts') ? 'page' : undefined}>文章</a>
      <a href="/#projects">作品</a>
      <a href="/about/" aria-current={currentPath.startsWith('/about') ? 'page' : undefined}>关于</a>
    </nav>
    <ThemeSwitcher />
  </div>
</header>
