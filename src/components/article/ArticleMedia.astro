---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata | string;
	alt: string;
	caption?: string;
	width?: 'content' | 'wide' | 'full';
}

const { src, alt, caption, width = 'content' } = Astro.props;
const isImageMetadata = typeof src === 'object' && 'src' in src;
---

<div class="article-media" data-width={width}>
	<figure class="article-media-figure">
		{isImageMetadata ? (
			<Image
				src={src as ImageMetadata}
				alt={alt}
				class="article-media-image"
				loading="lazy"
			/>
		) : (
			<img
				src={src as string}
				alt={alt}
				class="article-media-image"
				loading="lazy"
			/>
		)}
		{caption && <figcaption class="article-media-caption">{caption}</figcaption>}
	</figure>
</div>
