---
import type { BlogPost } from '../../lib/posts';
import { formatDate, getReadingTime, KIND_LABELS } from '../../lib/posts';
import { getSoftwareByArticleSlug } from '../../lib/software';
import ArticleRail from './ArticleRail.astro';
import NextArticle from './NextArticle.astro';
import CommentsPanel from './CommentsPanel.astro';

interface HeadingItem {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	post: BlogPost;
	headings: HeadingItem[];
	nextPost?: BlogPost | null;
}

const { post, headings, nextPost } = Astro.props;
const description = post.data.description;
const kindLabel = KIND_LABELS[post.data.kind] || '思考';
const kicker = post.data.kicker || kindLabel;
const linkedSoftware = getSoftwareByArticleSlug(post.id);
---

<!-- Fixed Reading Progress Indicator -->
<div class="reading-progress-bar" id="reading-progress" aria-hidden="true"></div>

<!-- Standard Article Header Section -->
<header class="article-header-section">
	<div class="shell article-header-inner">
		<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 24px;">
			<a class="article-back-link" href="/posts/" style="margin-bottom: 0;">
				<span aria-hidden="true">←</span>
				<span>返回文章索引</span>
			</a>
			{linkedSoftware && (
				<a class="status-pill" data-tone={linkedSoftware.statusTone} href={`/software/${linkedSoftware.slug}/`}>
					<span>对应软件产品：{linkedSoftware.name} ({linkedSoftware.statusBadge})</span>
				</a>
			)}
		</div>

		<div class="article-kicker-row">
			<span class="article-kicker">{kicker}</span>
		</div>

		<h1 class="article-page-title">{post.data.title}</h1>
		<p class="article-lead">{description}</p>

		<div class="article-meta-bar">
			<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
			{post.data.updatedDate && (
				<>
					<span aria-hidden="true">·</span>
					<time datetime={post.data.updatedDate.toISOString()}>更新于 {formatDate(post.data.updatedDate)}</time>
				</>
			)}
			<span aria-hidden="true">·</span>
			<span>{getReadingTime(post.body)}</span>

			{post.data.tags.length > 0 && (
				<div class="tag-list" style="margin-left: auto;">
					{post.data.tags.map((tag) => (
						<a class="tag-item" href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
					))}
				</div>
			)}
		</div>

		{linkedSoftware && (
			<aside class="related-article-banner" style="margin-top: 28px; padding: 20px 24px;" aria-label={`关联软件 ${linkedSoftware.name}`}>
				<div>
					<strong style="font-size: 14px; color: var(--text); display: block; margin-bottom: 4px;">
						本文对应的软件产品：{linkedSoftware.name}（{linkedSoftware.platformsLabel}）
					</strong>
					<p style="font-size: 13.5px;">{linkedSoftware.availabilitySummary}</p>
				</div>
				<div style="display: flex; flex-wrap: wrap; gap: 10px;">
					<a class="btn-primary" style="min-height: 38px; padding: 8px 16px; font-size: 13px;" href={`/software/${linkedSoftware.slug}/`}>
						进入 {linkedSoftware.name} 产品官网页
					</a>
					{linkedSoftware.downloads[0] && (
						<a class="btn-secondary" style="min-height: 38px; padding: 8px 16px; font-size: 13px;" href={linkedSoftware.downloads[0].url} target="_blank" rel="noopener noreferrer">
							下载 {linkedSoftware.downloads[0].version}
						</a>
					)}
				</div>
			</aside>
		)}
	</div>
</header>

<!-- Article Body & TOC Rail -->
<div class="shell article-layout">
	<article class="article-content-wrapper">
		<div class="article-prose">
			<slot />
		</div>
		<CommentsPanel post={post} />
		{nextPost && <NextArticle post={nextPost} />}
	</article>

	<ArticleRail headings={headings} />
</div>

<script>
	const progressBar = document.getElementById('reading-progress');
	if (progressBar) {
		const updateProgress = () => {
			const scrollTotal = document.documentElement.scrollHeight - window.innerHeight;
			if (scrollTotal > 0) {
				const progress = (window.scrollY / scrollTotal) * 100;
				progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
			}
		};

		window.addEventListener('scroll', updateProgress, { passive: true });
		window.addEventListener('resize', updateProgress, { passive: true });
		updateProgress();
	}
</script>
