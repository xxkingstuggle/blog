---
import type { BlogPost } from '../../lib/posts';

interface Props {
	prevPost?: BlogPost | null;
	post?: BlogPost | null;
}

const { prevPost, post } = Astro.props;
const hasBoth = Boolean(prevPost && post);
---

{(prevPost || post) && (
	<section class="next-article-section" aria-label="上下篇阅读导航">
		<div class:list={['next-article-grid', { 'next-article-grid--dual': hasBoth }]}>
			{prevPost && (
				<div class="next-article-slot">
					<div class="next-article-label">NEWER DISPATCH / 更新一篇</div>
					<a class="next-article-card" href={`/posts/${prevPost.id}/`}>
						<h4>{prevPost.data.title}</h4>
						<p>{prevPost.data.description}</p>
					</a>
				</div>
			)}
			{post && (
				<div class="next-article-slot">
					<div class="next-article-label">OLDER DISPATCH / 更早一篇</div>
					<a class="next-article-card" href={`/posts/${post.id}/`}>
						<h4>{post.data.title}</h4>
						<p>{post.data.description}</p>
					</a>
				</div>
			)}
		</div>
	</section>
)}
