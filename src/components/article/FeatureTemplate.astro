---
import type { BlogPost } from '../../lib/posts';
import GalleryHero from '../GalleryHero.astro';
import { formatDate, getReadingTime, KIND_LABELS } from '../../lib/posts';
import { getSoftwareByArticleSlug } from '../../lib/software';
import ArticleRail from './ArticleRail.astro';
import MobileToc from './MobileToc.astro';
import NextArticle from './NextArticle.astro';
import CommentsPanel from './CommentsPanel.astro';

interface HeadingItem {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	post: BlogPost;
	headings: HeadingItem[];
	prevPost?: BlogPost | null;
	nextPost?: BlogPost | null;
}

const { post, headings, prevPost, nextPost } = Astro.props;
const description = post.data.description;
const kindLabel = KIND_LABELS[post.data.kind] || '重点发布';
const kicker = post.data.kicker || `${kindLabel} · FEATURE`;
const linkedSoftware = getSoftwareByArticleSlug(post.id);
const hasToc = headings.some((h) => h.depth === 2 || h.depth === 3);
---

<!-- Fixed Reading Progress Indicator -->
<div class="reading-progress-bar" id="reading-progress" aria-hidden="true"></div>

<!-- Feature Release Immersive Header -->
<header class:list={['feature-header-section', { 'feature-header-section--no-rail': !hasToc }]}>
	<div class="shell feature-header-inner">
		<div class="feature-nav-row">
			<a class="article-back-link" href="/posts/">
				<span aria-hidden="true">←</span>
				<span>返回全部发布</span>
			</a>
			<div class="feature-badge-row">
				<span class="badge-featured">{kicker}</span>
				{linkedSoftware && (
					<a class="status-pill" data-tone={linkedSoftware.statusTone} href={`/software/${linkedSoftware.slug}/`}>
						<span>对应软件产品：{linkedSoftware.name} ({linkedSoftware.statusBadge})</span>
					</a>
				)}
			</div>
		</div>

		<h1 class="feature-page-title">{post.data.title}</h1>
		<p class="feature-lead">{description}</p>

		<dl class="godly-detail-facts" aria-label="文章信息">
      <div><dt>内容类型</dt><dd>{kindLabel}</dd></div>
      <div>
        <dt>发布时间</dt>
        <dd><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></dd>
        {post.data.updatedDate && <dd class="godly-detail-update">更新于 {formatDate(post.data.updatedDate)}</dd>}
      </div>
      <div><dt>阅读时间</dt><dd>{getReadingTime(post.body)}</dd></div>
      <div>
        <dt>相关标签</dt>
        <dd class="godly-detail-topics">
          {post.data.tags.length > 0
            ? post.data.tags.map((tag) => <a href={'/tags/' + encodeURIComponent(tag) + '/'}>{tag}</a>)
            : <span>手记</span>}
        </dd>
      </div>
    </dl>

		{linkedSoftware && (
			<aside class="related-article-banner" aria-label={`关联软件 ${linkedSoftware.name}`}>
				<div>
					<strong style="font-size: 14px; color: var(--text); display: block; margin-bottom: 4px;">
						本文对应的软件产品：{linkedSoftware.name}（{linkedSoftware.platformsLabel}）
					</strong>
					<p style="font-size: 13.5px;">{linkedSoftware.availabilitySummary}</p>
				</div>
				<div style="display: flex; flex-wrap: wrap; gap: 10px;">
					<a class="btn-primary" style="min-height: 38px; padding: 8px 16px; font-size: 13px;" href={`/software/${linkedSoftware.slug}/`}>
						进入 {linkedSoftware.name} 产品官网页
					</a>
					{linkedSoftware.downloads[0] && (
						<a class="btn-secondary" style="min-height: 38px; padding: 8px 16px; font-size: 13px;" href={linkedSoftware.downloads[0].url} target="_blank" rel="noopener noreferrer">
							下载 {linkedSoftware.downloads[0].version}
						</a>
					)}
				</div>
			</aside>
		)}

	</div>
	<GalleryHero post={post} />
</header>

<!-- Feature Body Layout with TOC Rail -->
<div class:list={['shell', 'article-layout', 'feature-layout', { 'article-layout--no-rail': !hasToc }]}>
	<article class="article-content-wrapper feature-content-wrapper">
		<MobileToc headings={headings} />
		<div class="article-prose feature-prose">
			<slot />
		</div>
		<CommentsPanel post={post} />
		{(prevPost || nextPost) && <NextArticle prevPost={prevPost} post={nextPost} />}
	</article>

	{hasToc && <ArticleRail headings={headings} />}
</div>

<style>
	.feature-header-section {
		padding: clamp(64px, 10vw, 108px) 0 44px;
		border-bottom: 1px solid var(--line);
		background: radial-gradient(circle at 50% 0%, var(--surface-subtle) 0%, transparent 70%);
	}

	.feature-header-inner {
		max-width: 900px;
		margin-inline: auto;
	}

	.feature-nav-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 32px;
	}

	.feature-nav-row .article-back-link {
		margin-bottom: 0;
	}

	.feature-page-title {
		font-size: clamp(2.5rem, 5.8vw, 4.4rem);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.04em;
		margin-bottom: 24px;
		color: var(--text);
		word-break: break-word;
	}

	.feature-lead {
		font-size: clamp(1.2rem, 2.4vw, 1.45rem);
		line-height: 1.6;
		color: var(--text-muted);
		margin-bottom: 36px;
	}

	.feature-layout {
		padding-top: 56px;
	}
</style>

<script>
	import '../../scripts/reading-progress';
</script>
