---
import { siteConfig } from '../config';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="shell">
		<div class="footer-main">
			<div class="footer-col-brand">
				<h3>{siteConfig.name}</h3>
				<p>{siteConfig.description}</p>
			</div>
			<div class="footer-col">
				<div class="footer-col-title">导航</div>
				<ul class="footer-link-list">
					<li><a href="/posts/">全部发布</a></li>
					<li><a href="/archive/">时间归档</a></li>
					<li><a href="/tags/">标签索引</a></li>
					<li><a href="/about/">关于</a></li>
				</ul>
			</div>
			<div class="footer-col">
				<div class="footer-col-title">订阅与连接</div>
				<ul class="footer-link-list">
					<li><a href="/rss.xml">RSS 订阅</a></li>
					<li><a href="/sitemap.xml">站点地图</a></li>
					<li><a href="https://github.com/xxkingstuggle/blog" target="_blank" rel="noopener noreferrer">GitHub ↗</a></li>
				</ul>
			</div>
		</div>
		<div class="footer-bottom">
			<span>© {year} {siteConfig.author}. 保持清醒，持续构建。</span>
			<span>xingx.cc.cd / Personal Releases</span>
		</div>
	</div>
</footer>
