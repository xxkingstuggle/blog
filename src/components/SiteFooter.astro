import { siteConfig } from '../config';
---
<footer class="site-footer studio-footer">
  <div class="shell studio-footer-top">
    <div class="studio-footer-intro">
      <span class="studio-footer-kicker">AN INDEPENDENT CREATIVE SPACE / 2026</span>
      <h2>让好奇心，<br/>一直有地方落脚。</h2>
      <p>软件、设计、工程复盘与不断更新的想法。一个人的作品集，也是一段持续进行中的实验。</p>
      <a href="/about/#contact" class="studio-footer-contact">聊聊你的想法 <span aria-hidden="true">↗</span></a>
    </div>
    <div class="studio-footer-link-groups">
      <nav aria-label="作品导航"><h3>EXPLORE</h3><a href="/">精选首页</a><a href="/software/">全部软件</a><a href="/software/usblinkmic/">USBLinkMic {SOFTWARE_PRODUCTS[0].latestVersion}</a><a href="/software/habitbloom/">HabitBloom</a></nav>
      <nav aria-label="文章导航"><h3>JOURNAL</h3><a href="/posts/">全部文章</a><a href="/archive/">时间归档</a><a href="/tags/">文章标签</a><a href="/rss.xml">RSS</a></nav>
