<div class="theme-segmented" data-theme-switcher role="radiogroup" aria-label="显示主题">
	<span class="theme-segmented-pill" data-theme-pill aria-hidden="true"></span>
	<button
		type="button"
		class="theme-option"
		data-theme-value="light"
		role="radio"
		aria-checked="false"
		aria-label="浅色主题"
		title="浅色主题"
	>
		<svg class="theme-option-icon" viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="8" cy="8" r="3.2" />
			<path d="M8 1.5v1.6M8 12.9v1.6M1.5 8h1.6M12.9 8h1.6M3.4 3.4l1.15 1.15M11.45 11.45l1.15 1.15M12.6 3.4l-1.15 1.15M4.55 11.45 3.4 12.6" />
		</svg>
		<span>浅色</span>
	</button>
	<button
		type="button"
		class="theme-option"
		data-theme-value="dark"
		role="radio"
		aria-checked="false"
		aria-label="深色主题"
		title="深色主题"
	>
		<svg class="theme-option-icon" viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M13.2 10.1A5.8 5.8 0 0 1 5.9 2.8a5.8 5.8 0 1 0 7.3 7.3Z" />
		</svg>
		<span>深色</span>
	</button>
	<button
		type="button"
		class="theme-option"
		data-theme-value="system"
		role="radio"
		aria-checked="true"
		aria-label="跟随系统"
		title="跟随系统"
	>
		<svg class="theme-option-icon" viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<rect x="2" y="2.5" width="12" height="8.5" rx="1.8" />
			<path d="M5.5 13.5h5M8 11v2.5" />
		</svg>
		<span>系统</span>
	</button>
</div>

<script>
  const switchers = [...document.querySelectorAll<HTMLElement>('[data-theme-switcher]')];
  const options = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-value]')];
  const root = document.documentElement;
  const cookieName = 'xingx-color-mode';
  type ColorMode = 'system' | 'light' | 'dark';
  const order: ColorMode[] = ['light', 'dark', 'system'];

  function readMode(): ColorMode {
    const match = document.cookie.match(/(?:^|; )xingx-color-mode=([^;]+)/);
    const value = match?.[1];
    return value === 'light' || value === 'dark' ? value : 'system';
  }

  function readCachedMode(): ColorMode {
    const mode = readMode();
    if (mode !== 'system' || document.cookie.includes(cookieName + '=system')) return mode;
    try {
      const cached = localStorage.getItem(cookieName);
      return cached === 'light' || cached === 'dark' ? cached : 'system';
    } catch { return 'system'; }
  }

  function setMode(mode: ColorMode) {
    root.dataset.colorMode = mode;
    const sharedDomain = location.hostname === 'myzjx.com' || location.hostname.endsWith('.myzjx.com')
      ? ' Domain=myzjx.com;' : '';
    document.cookie = cookieName + '=' + mode + '; Path=/;' + sharedDomain
      + ' Max-Age=31536000; SameSite=Lax' + (location.protocol === 'https:' ? '; Secure' : '');
    try { localStorage.setItem(cookieName, mode); } catch { /* Private mode. */ }
    const idx = Math.max(0, order.indexOf(mode));
    switchers.forEach(sw => {
      sw.dataset.activeMode = mode;
      sw.style.setProperty('--theme-idx', String(idx));
    });
    options.forEach(option =>
      option.setAttribute('aria-checked', String(option.dataset.themeValue === mode)));
  }

  setMode(readCachedMode());

  options.forEach(option => {
    option.addEventListener('click', () => {
      const value = option.dataset.themeValue;
      if (value !== 'system' && value !== 'light' && value !== 'dark') return;
      setMode(value);
    });
  });
</script>
