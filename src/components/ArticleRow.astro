---
import type { BlogPost } from '../lib/posts';
import { formatDate, getReadingTime, KIND_LABELS } from '../lib/posts';
import { getSoftwareByArticleSlug } from '../lib/software';

interface Props {
	post: BlogPost;
	index?: number;
}

const { post } = Astro.props;
const kindLabel = KIND_LABELS[post.data.kind] || '思考';
const kicker = post.data.kicker || kindLabel;
const linkedSoftware = getSoftwareByArticleSlug(post.id);
---

<a class="article-row" href={`/posts/${post.id}/`}>
	<div class="article-row-meta-left">
		<span class="article-row-kicker" data-kind={post.data.kind}>{kicker}</span>
	</div>
	<div class="article-row-content">
		<div class="article-row-title-wrap">
			<h3 class="article-row-title">{post.data.title}</h3>
			{post.data.presentation === 'feature' && (
				<span class="badge-featured">专题深读</span>
			)}
			{linkedSoftware && (
				<span class="badge-demo">配套软件：{linkedSoftware.name}</span>
			)}
		</div>
		<p class="article-row-desc">{post.data.description}</p>
	</div>
	<div class="article-row-meta">
		<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
		<span>{getReadingTime(post.body)}</span>
	</div>
</a>
