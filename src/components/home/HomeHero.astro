---
interface Props {
	featuredPostSlug?: string;
}

const { featuredPostSlug = 'allow-discomfort' } = Astro.props;
---

<section class="hero-section" id="hero" aria-label="Hero 欢迎区">
	<!-- Generative Canvas 2D Lightfield -->
	<canvas class="hero-canvas" id="hero-canvas" aria-hidden="true"></canvas>

	<!-- Static Fallback for prefers-reduced-motion -->
	<div class="hero-canvas-fallback" aria-hidden="true"></div>

	<div class="shell hero-content">
		<div class="hero-eyebrow">XINGX.CC.CD / PERSONAL RELEASES</div>
		<h1 class="hero-title">把想法，<br />做成可以被看见的东西。</h1>
		<p class="hero-lead">这里发布我的思考、项目和近况，也记录它们如何从想法变成作品。</p>
		<div class="hero-actions">
			<a class="btn-hero-primary" href={featuredPostSlug ? `/posts/${featuredPostSlug}/` : '#featured'}>
				<span>查看重点发布</span>
				<span aria-hidden="true">→</span>
			</a>
			<a class="btn-hero-secondary" href="#latest">
				<span>浏览全部发布</span>
				<span aria-hidden="true">↓</span>
			</a>
		</div>
	</div>
</section>

<script>
	// Generative Lightfield Canvas 2D
	const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
	const heroSection = document.getElementById('hero');

	if (canvas && heroSection) {
		const context = canvas.getContext('2d', { alpha: true });
		if (context) {
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (!prefersReducedMotion) {
				interface Particle {
					x: number;
					y: number;
					vx: number;
					vy: number;
					baseX: number;
					baseY: number;
					size: number;
					alpha: number;
					color: string;
					phase: number;
				}

				let particles: Particle[] = [];
				let width = 0;
				let height = 0;
				let dpr = Math.min(window.devicePixelRatio || 1, 2);
				let animationId = 0;
				let isVisible = true;
				let mouseX = -9999;
				let mouseY = -9999;
				let lastScrollY = window.scrollY;
				let scrollVelocity = 0;

				function resize() {
					if (!canvas || !heroSection || !context) return;
					width = heroSection.clientWidth;
					height = heroSection.clientHeight;
					dpr = Math.min(window.devicePixelRatio || 1, 2);

					canvas.width = Math.floor(width * dpr);
					canvas.height = Math.floor(height * dpr);
					context.setTransform(1, 0, 0, 1, 0, 0);
					context.scale(dpr, dpr);

					initParticles();
				}

				function initParticles() {
					particles = [];
					const isMobile = width < 768;
					const count = isMobile ? 42 : 110;

					for (let i = 0; i < count; i++) {
						const x = Math.random() * width;
						const y = Math.random() * height;
						const isFluorescent = Math.random() > 0.68;
						particles.push({
							x,
							y,
							baseX: x,
							baseY: y,
							vx: (Math.random() - 0.5) * 0.45,
							vy: (Math.random() - 0.5) * 0.45,
							size: isFluorescent ? Math.random() * 1.8 + 1.2 : Math.random() * 1.2 + 0.6,
							alpha: isFluorescent ? Math.random() * 0.65 + 0.3 : Math.random() * 0.25 + 0.1,
							color: isFluorescent ? '#B6FF3B' : '#6A7D6E',
							phase: Math.random() * Math.PI * 2,
						});
					}
				}

				function onMouseMove(e: MouseEvent) {
					const rect = heroSection?.getBoundingClientRect();
					if (rect) {
						mouseX = e.clientX - rect.left;
						mouseY = e.clientY - rect.top;
					}
				}

				function onMouseLeave() {
					mouseX = -9999;
					mouseY = -9999;
				}

				function onScroll() {
					const currentScrollY = window.scrollY;
					scrollVelocity = (currentScrollY - lastScrollY) * 0.15;
					lastScrollY = currentScrollY;
				}

				let time = 0;
				function render() {
					if (!isVisible || !context) return;
					time += 0.015;
					scrollVelocity *= 0.92;

					context.clearRect(0, 0, width, height);

					// Draw soft fluid glow in background
					const glowGrad = context.createRadialGradient(
						width * 0.6,
						height * 0.4,
						20,
						width * 0.6,
						height * 0.4,
						width * 0.5
					);
					glowGrad.addColorStop(0, 'rgba(182, 255, 59, 0.06)');
					glowGrad.addColorStop(1, 'rgba(8, 10, 8, 0)');
					context.fillStyle = glowGrad;
					context.fillRect(0, 0, width, height);

					// Connect close particles with subtle energy streamlines
					const connectionDist = width < 768 ? 70 : 100;
					for (let i = 0; i < particles.length; i++) {
						for (let j = i + 1; j < particles.length; j++) {
							const dx = particles[i].x - particles[j].x;
							const dy = particles[i].y - particles[j].y;
							const dist = Math.sqrt(dx * dx + dy * dy);

							if (dist < connectionDist) {
								const alpha = (1 - dist / connectionDist) * 0.18;
								context.beginPath();
								context.strokeStyle = `rgba(182, 255, 59, ${alpha})`;
								context.lineWidth = 0.8;
								context.moveTo(particles[i].x, particles[i].y);
								context.lineTo(particles[j].x, particles[j].y);
								context.stroke();
							}
						}
					}

					// Update & Draw particles
					for (let i = 0; i < particles.length; i++) {
						const p = particles[i];

						// Natural drift
						p.x += p.vx + Math.sin(time + p.phase) * 0.3;
						p.y += p.vy + Math.cos(time + p.phase) * 0.3 + scrollVelocity;

						// Mouse perturbation field
						const dx = mouseX - p.x;
						const dy = mouseY - p.y;
						const dist = Math.sqrt(dx * dx + dy * dy);
						const mouseRadius = 140;

						if (dist < mouseRadius && dist > 0) {
							const force = (1 - dist / mouseRadius) * 2.5;
							p.x -= (dx / dist) * force;
							p.y -= (dy / dist) * force;
						}

						// Bounds wrap
						if (p.x < -20) p.x = width + 20;
						if (p.x > width + 20) p.x = -20;
						if (p.y < -20) p.y = height + 20;
						if (p.y > height + 20) p.y = -20;

						// Draw particle
						context.beginPath();
						context.arc(p.x, p.y, p.size, 0, Math.PI * 2);
						context.fillStyle = p.color;
						context.globalAlpha = p.alpha;
						context.fill();
						context.globalAlpha = 1.0;
					}

					animationId = requestAnimationFrame(render);
				}

				function startAnimation() {
					if (!animationId) {
						animationId = requestAnimationFrame(render);
					}
				}

				function stopAnimation() {
					if (animationId) {
						cancelAnimationFrame(animationId);
						animationId = 0;
					}
				}

				// Lifecycle: pause when out of viewport
				if ('IntersectionObserver' in window) {
					const observer = new IntersectionObserver(
						([entry]) => {
							isVisible = entry.isIntersecting;
							if (isVisible) startAnimation();
							else stopAnimation();
						},
						{ threshold: 0.05 }
					);
					observer.observe(heroSection);
				}

				window.addEventListener('resize', resize, { passive: true });
				window.addEventListener('mousemove', onMouseMove, { passive: true });
				window.addEventListener('mouseleave', onMouseLeave, { passive: true });
				window.addEventListener('scroll', onScroll, { passive: true });

					resize();
					startAnimation();
				} else {
					heroSection.classList.add('hero-no-canvas');
				}
		} else {
			heroSection.classList.add('hero-no-canvas');
		}
	} else if (heroSection) {
		heroSection.classList.add('hero-no-canvas');
	}
</script>
