---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  href: string;
  title: string;
  description: string;
  category: string;
  meta?: string;
  image?: ImageMetadata;
  tone?: 'tool' | 'thinking' | 'project' | 'update';
  index?: number;
  transitionKey?: string;
}
const { href, title, description, category, meta, image, tone = 'project', index = 0, transitionKey } = Astro.props;
const transitionStyle = transitionKey ? 'view-transition-name: ' + transitionKey.replace(/[^a-zA-Z0-9_-]/g, '-') : undefined;
---
<a href={href} class="gallery-card" data-gallery-card aria-label={title}>
  <div class:list={['gallery-card-visual', 'gallery-card-visual--' + tone]} style={transitionStyle}>
    {image ? (
      <Image src={image} alt={title + ' 项目预览'} widths={[480, 760, 1120]} sizes="(max-width: 620px) 92vw, (max-width: 1100px) 45vw, 30vw" format="webp" class="gallery-card-image" loading={index < 3 ? 'eager' : 'lazy'} />
    ) : (
      <div class="gallery-card-art" aria-hidden="true">
        <span class="gallery-art-eyebrow">MYZJX / {category}</span>
        <div class="gallery-art-shape"><span></span><span></span><span></span></div>
        <strong>{title}</strong>
        <span class="gallery-art-index">{String(index + 1).padStart(2, '0')} / STUDIO</span>
      </div>
    )}
    <span class="gallery-visual-category">{category}</span>
    <span class="gallery-visual-action" aria-hidden="true">↗</span>
  </div>
  <div class="gallery-card-info">
    <div class="gallery-card-caption"><h3>{title}</h3><span class="gallery-card-arrow" aria-hidden="true">↗</span></div>
    <p>{description}</p>
    {meta && <span class="gallery-card-meta">{meta}</span>}
  </div>
</a>
