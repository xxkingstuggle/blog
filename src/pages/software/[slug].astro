---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SOFTWARE_PRODUCTS, type SoftwareProduct, type SoftwareGalleryItem } from '../../lib/software';

export function getStaticPaths() {
	return SOFTWARE_PRODUCTS.map((product) => ({
		params: { slug: product.slug },
		props: { product },
	}));
}

interface Props {
	product: SoftwareProduct;
}

const { product } = Astro.props;
const primaryDownload = product.downloads.find((d) => d.primary) ?? product.downloads[0];

const baseGallery: SoftwareGalleryItem[] =
	product.gallery && product.gallery.length > 0
		? product.gallery
		: [
				{
					src: product.screenshot.src,
					width: product.screenshot.width,
					height: product.screenshot.height,
					alt: product.screenshotAlt,
					kicker: '01 · PRIMARY INTERFACE',
					title: product.interfaceHeading ?? `${product.name} 原生主界面`,
					caption: product.screenshotCaption,
					mechanism: product.platforms.join(' · '),
				},
			];

const stageViews: SoftwareGalleryItem[] =
	product.slug === 'habitbloom'
		? [
				...baseGallery,
				{
					src: '/media/habitbloom/habitbloom-engineering-scope.svg',
					width: 1200,
					height: 675,
					alt: 'HabitBloom 的 SwiftUI 本地记录、WidgetKit 交互和 Cloudflare 远程能力组成结构图',
					kicker: '03 · MODULE BOUNDARIES',
					title: '本地 SwiftData 优先，远端快照按需插拔',
					caption:
						'主应用基于 SwiftUI 与 SwiftData 构建本地持久层，无需注册账号或部署云端即可独立完成日常习惯打卡、连续天数统计与本地通知提醒；Cloudflare Worker 与 Durable Objects 作为可选远端层按需启用。',
					mechanism: 'SwiftUI · SwiftData · WidgetKit · Cloudflare Durable Objects',
				},
				{
					src: '/media/habitbloom/habitbloom-data-path.svg',
					width: 1200,
					height: 675,
					alt: 'SwiftData 数据保存和 Widget 快照、App Group 及 Cloudflare 读取路径的示意图',
					kicker: '04 · CROSS-PROCESS SNAPSHOT PATH',
					title: '从主应用到桌面 Widget 的双通道状态回并',
					caption:
						'标准环境下通过 App Group 共享容器读写 Widget 快照；针对免费个人证书侧载时 App Group 可能受限的场景，提供轻量 HTTP 远端快照回退路径，并在主应用唤醒时执行增量状态合并。',
					mechanism: 'App Intents 交互打卡 · App Group 共享容器 · HTTP 快照回并',
				},
			]
		: baseGallery;

function shortTabLabel(item: SoftwareGalleryItem): string {
	const clean = item.title.replace(/[，。：、·].*$/, '').trim();
	if (clean.length <= 20) return clean;
	return clean.slice(0, 20) + '…';
}

const versionStatusText = product.statusBadge.includes(product.latestVersion) || product.statusBadge.startsWith('v')
	? product.statusBadge
	: `${product.latestVersion} · ${product.statusBadge}`;
---

<BaseLayout
	title={`${product.name} — ${product.category}`}
	description={`${product.tagline}。${product.availabilitySummary}`}
	image={product.screenshot}
	layoutVariant="launch"
>
	<div class="launch-page">
		<!-- 1. Floating Liquid-Glass Product Sub-Topbar -->
		<div class="launch-subnav-wrap">
			<div class="shell">
				<div class="launch-subnav">
					<div class="launch-subnav-identity">
						<a class="launch-subnav-back" href="/software/" aria-label="返回软件与作品集">
							<span aria-hidden="true">←</span>
						</a>
						<Image
							class="launch-subnav-icon"
							src={product.icon}
							alt=""
							width={26}
							height={26}
							format="webp"
							densities={[1, 2]}
							decoding="async"
						/>
						<span class="launch-subnav-name">{product.name}</span>
						<span class="launch-subnav-version">{product.latestVersion}</span>
					</div>

					<nav class="launch-subnav-links" data-liquid-nav aria-label="产品页章节导航">
						<span class="liquid-nav-pill" aria-hidden="true"></span>
						<a href="#stage" aria-current="page">界面与预览</a>
						<a href="#capabilities">核心能力</a>
						<a href="#scenarios">场景与上手</a>
						<a href="#downloads">{product.downloads.length ? '下载与规格' : '规格与来源'}</a>
						<a href="#faq">常见问题</a>
					</nav>

					<div class="launch-subnav-actions">
						<a
							class="launch-subnav-cta"
							href={product.downloads.length ? '#downloads' : `/posts/${product.articleSlug}/`}
						>
							<span>{product.downloads.length ? `获取 ${product.latestVersion}` : '阅读工程手记'}</span>
							<span aria-hidden="true">{product.downloads.length ? '↘' : '→'}</span>
						</a>
					</div>
				</div>
			</div>
		</div>

		<!-- 2. Flagship Hero & 4-Column Spec Trust Strip -->
		<header class="launch-hero">
			<div class="shell">
				<div class="launch-hero-center" data-reveal>
					<div class="launch-icon-pedestal">
						<Image
							class="launch-app-icon"
							src={product.icon}
							alt={`${product.name} 应用图标`}
							width={72}
							height={72}
							format="webp"
							densities={[1, 2]}
							loading="eager"
							decoding="async"
						/>
					</div>

					<div class="launch-badge-row">
						<span class="status-pill" data-tone={product.statusTone}>{product.statusBadge}</span>
						<span class="status-pill">{product.platformsLabel}</span>
					</div>

					<h1 class="launch-title">
						<span class="launch-title-name">{product.name} · {product.category}</span>
						{product.headline}
					</h1>

					<p class="launch-summary">{product.summary}</p>

					<div class="launch-cta-row">
						<a
							class="btn-primary"
							href={product.downloads.length ? '#downloads' : `/posts/${product.articleSlug}/`}
						>
							<span>
								{primaryDownload
									? primaryDownload.label.startsWith('下载')
										? primaryDownload.label
										: `下载 ${primaryDownload.label}`
									: '阅读工程架构手记'}
							</span>
							<span class="launch-cta-meta">{product.latestVersion}</span>
						</a>
						{product.repoVisibility === 'public' && (
							<a
								class="btn-secondary"
								href={product.repoUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								<span>GitHub 开源仓库</span>
								<span aria-hidden="true">↗</span>
							</a>
						)}
						<a class="btn-secondary" href={`/posts/${product.articleSlug}/`}>
							<span>配套工程手记</span>
							<span aria-hidden="true">→</span>
						</a>
					</div>
				</div>

				<dl class="launch-trust-strip" aria-label="版本与工程核验摘要" data-reveal>
					<div class="launch-trust-cell">
						<dt>VERSION &amp; STATUS</dt>
						<dd>{versionStatusText}</dd>
					</div>
					<div class="launch-trust-cell">
						<dt>TARGET PLATFORMS</dt>
						<dd>{product.platforms.join(' / ')}</dd>
					</div>
					<div class="launch-trust-cell">
						<dt>DELIVERY &amp; SOURCE</dt>
						<dd>
							{product.repoVisibility === 'public' ? 'GitHub 开源 · ' : ''}
							{product.downloads.length
								? `${product.downloads.length} 项构建产物与校验`
								: '开源工程与架构复盘'}
						</dd>
					</div>
					<div class="launch-trust-cell">
						<dt>VERIFIED RECORD</dt>
						<dd>{product.verifiedAt}</dd>
					</div>
				</dl>

				<!-- 3. Interactive Multi-View Optical Stage -->
				<div class="launch-stage-wrapper" id="stage" data-reveal>
					<div class="launch-stage-controls">
						<div
							class="launch-view-tabs"
							data-liquid-nav
							role="tablist"
							aria-label={`${product.name} 界面与架构视图切换`}
						>
							<span class="liquid-nav-pill" aria-hidden="true"></span>
							{stageViews.map((view, idx) => (
								<button
									type="button"
									class="launch-view-tab"
									role="tab"
									id={`stage-tab-${idx}`}
									aria-controls={`stage-pane-${idx}`}
									aria-selected={idx === 0 ? 'true' : 'false'}
									tabindex={idx === 0 ? 0 : -1}
									data-stage-tab={String(idx)}
								>
									<span class="launch-view-tab-num">{String(idx + 1).padStart(2, '0')}</span>
									<span>{shortTabLabel(view)}</span>
								</button>
							))}
						</div>
						<div class="section-kicker">
							<span class="kicker-dot" aria-hidden="true"></span>
							<span>{product.galleryKicker ?? 'OPTICAL STAGE · 零裁切真实界面'}</span>
						</div>
					</div>

					<div
						class="launch-stage-frame"
						style={`view-transition-name: work-${product.slug};`}
					>
						{stageViews.map((view, idx) => (
							<div
								class="launch-stage-pane"
								role="tabpanel"
								id={`stage-pane-${idx}`}
								aria-labelledby={`stage-tab-${idx}`}
								data-stage-pane={String(idx)}
								hidden={idx !== 0}
							>
								<div
									class:list={[
										'launch-stage-media',
										view.narrow && !view.secondary && 'launch-stage-media--narrow',
									]}
								>
									<img
										src={view.src}
										width={view.width}
										height={view.height}
										alt={view.alt}
										loading={idx === 0 ? 'eager' : 'lazy'}
										fetchpriority={idx === 0 ? 'high' : 'auto'}
										decoding="async"
									/>
									{view.secondary && (
										<img
											src={view.secondary.src}
											width={view.secondary.width}
											height={view.secondary.height}
											alt={view.secondary.alt}
											loading="lazy"
											decoding="async"
										/>
									)}
								</div>

								<div class="launch-stage-caption-bar">
									<div class="launch-stage-caption-copy">
										<span class="launch-stage-caption-kicker">
											{view.kicker ?? `${String(idx + 1).padStart(2, '0')} · WORKSPACE VIEW`}
										</span>
										<strong>{view.title}</strong>
										<p>{view.caption}</p>
									</div>
									{view.mechanism && (
										<span class="launch-stage-mechanism">{view.mechanism}</span>
									)}
								</div>
							</div>
						))}
					</div>
				</div>
			</div>
		</header>

		<!-- 4. Bento Capabilities Matrix -->
		<section class="launch-section" id="capabilities" aria-labelledby="capabilities-heading">
			<div class="shell">
				<div class="launch-section-head" data-reveal>
					<div class="section-kicker">
						<span class="kicker-dot" aria-hidden="true"></span>
						<span>CORE CAPABILITIES · 核心能力与机制</span>
					</div>
					<h2 id="capabilities-heading">{product.galleryHeading ?? product.tagline}</h2>
					<p>{product.tagline}。围绕真实日常高频动作收敛功能边界，拒绝无效堆砌。</p>
				</div>

				<div class="launch-bento-grid">
					{product.highlights.map((item, idx) => (
						<article class="launch-bento-card" data-reveal>
							<span class="launch-bento-num">
								{String(idx + 1).padStart(2, '0')} · CAPABILITY
							</span>
							<h3>{item.title}</h3>
							<p>{item.body}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<!-- 5. Scenarios & 3-Step Workflow -->
		<section class="launch-section" id="scenarios" aria-labelledby="scenarios-heading">
			<div class="shell">
				<div class="launch-section-head" data-reveal>
					<div class="section-kicker">
						<span class="kicker-dot" aria-hidden="true"></span>
						<span>REAL-WORLD SCENARIOS · 典型使用场景</span>
					</div>
					<h2 id="scenarios-heading">解决具体工作流里的真实摩擦</h2>
					<p>将原本繁琐的命令行拼装、多窗口切换或黑盒排查收敛为确定性的可视化操作。</p>
				</div>

				<div class="launch-tri-grid">
					{product.scenarios.map((item, idx) => (
						<article class="launch-scenario-card" data-reveal>
							<span class="launch-bento-num">
								SCENARIO {String(idx + 1).padStart(2, '0')}
							</span>
							<h3>{item.scenario}</h3>
							<div class="launch-scenario-list">
								<div>
									<strong>常见痛点</strong>
									{item.pain}
								</div>
								<div>
									<strong>实际效果</strong>
									{item.outcome}
								</div>
								<div>
									<strong>底层机制</strong>
									{item.mechanism}
								</div>
							</div>
						</article>
					))}
				</div>

				<div class="launch-section-head" style="margin-top: 56px;" data-reveal>
					<div class="section-kicker">
						<span class="kicker-dot" aria-hidden="true"></span>
						<span>HOW IT WORKS · 三步上手</span>
					</div>
					<h2>从安装到投入使用的最短路径</h2>
				</div>

				<div class="launch-tri-grid">
					{product.workflow.map((step) => (
						<article class="launch-step-card" data-reveal>
							<span class="launch-step-num">STEP {step.step}</span>
							<h3>{step.title}</h3>
							<p>{step.description}</p>
							<p class="launch-step-detail">{step.detail}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<!-- 6. Download & Technical Specs Split -->
		<section class="launch-section" id="downloads" aria-labelledby="downloads-heading">
			<div class="shell">
				<div class="launch-section-head" data-reveal>
					<div class="section-kicker">
						<span class="kicker-dot" aria-hidden="true"></span>
						<span>RELEASE &amp; SPECIFICATIONS · 获取与技术规格</span>
					</div>
					<h2 id="downloads-heading">
						{product.downloads.length
							? `下载 ${product.name} ${product.latestVersion}`
							: `${product.name} 工程获取与技术规格`}
					</h2>
					<p>{product.availabilitySummary}</p>
				</div>

				<div class="launch-specs-layout">
					<div class="launch-download-panel" data-reveal>
						<h3>{product.downloads.length ? '发行安装包与校验' : '开源仓库与架构手记'}</h3>
						<p style="font-size: 13.5px; color: var(--text-secondary); margin: 0;">
							{product.availabilityNotice}
						</p>

						{product.downloads.length > 0 && (
							<div class="launch-download-list">
								{product.downloads.map((item) => (
									<a
										class="launch-download-item"
										data-primary={item.primary ? 'true' : undefined}
										href={item.url}
										target="_blank"
										rel="noopener noreferrer"
									>
										<div class="launch-download-main">
											<strong>
												{item.label} · {item.version}
											</strong>
											<span>
												{item.platform}
												{item.note ? ` · ${item.note}` : ''}
											</span>
										</div>
										<span class="launch-download-badge">
											{item.format} · {item.size} ↘
										</span>
									</a>
								))}
							</div>
						)}

						<div
							style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--line-subtle);"
						>
							<a class="btn-secondary" href={`/posts/${product.articleSlug}/`}>
								<span>阅读：{product.articleTitle}</span>
								<span aria-hidden="true">→</span>
							</a>
							{product.checksumsUrl && (
								<a
									class="btn-secondary"
									href={product.checksumsUrl}
									target="_blank"
									rel="noopener noreferrer"
								>
									<span>SHA-256 校验清单</span>
									<span aria-hidden="true">↗</span>
								</a>
							)}
							{product.sources.map((source) => (
								<a
									class="btn-secondary"
									href={source.url}
									target={source.url.startsWith('http') ? '_blank' : undefined}
									rel={source.url.startsWith('http') ? 'noopener noreferrer' : undefined}
								>
									<span>{source.label}</span>
									<span aria-hidden="true">{source.url.startsWith('http') ? '↗' : '→'}</span>
								</a>
							))}
						</div>
					</div>

					<div class="launch-spec-panel" data-reveal>
						<h3>技术规格参数</h3>
						<p style="font-size: 13.5px; color: var(--text-secondary); margin: 0;">
							{product.installedVersion}
						</p>
						<dl class="launch-spec-dl">
							<div class="launch-spec-row">
								<dt>当前版本</dt>
								<dd>{product.latestVersion}（{product.releaseDate}）</dd>
							</div>
							<div class="launch-spec-row">
								<dt>适用平台</dt>
								<dd>{product.platforms.join(' / ')}</dd>
							</div>
							<div class="launch-spec-row">
								<dt>开发基线</dt>
								<dd>{product.developmentVersion}</dd>
							</div>
							{product.specs.map((spec) => (
								<div class="launch-spec-row">
									<dt>{spec.label}</dt>
									<dd>{spec.value}</dd>
								</div>
							))}
						</dl>
					</div>
				</div>
			</div>
		</section>

		<!-- 7. Accordion FAQ & Engineering Boundaries -->
		<section class="launch-section" id="faq" aria-labelledby="faq-heading">
			<div class="shell">
				<div class="launch-section-head" data-reveal>
					<div class="section-kicker">
						<span class="kicker-dot" aria-hidden="true"></span>
						<span>FAQ &amp; BOUNDARIES · 常见问题与适用边界</span>
					</div>
					<h2 id="faq-heading">使用前值得了解的细节</h2>
					<p>{product.contribution}</p>
				</div>

				<div class="launch-faq-grid">
					{product.faq.map((item, idx) => (
						<details class="launch-faq-item" open={idx === 0}>
							<summary>
								<span>{item.question}</span>
								<span class="launch-faq-icon" aria-hidden="true">+</span>
							</summary>
							<div class="launch-faq-body">
								<p>{item.answer}</p>
							</div>
						</details>
					))}

					{product.limitations.length > 0 && (
						<details class="launch-faq-item">
							<summary>
								<span>已知适用边界与环境前提（{product.limitations.length} 项）</span>
								<span class="launch-faq-icon" aria-hidden="true">+</span>
							</summary>
							<div class="launch-faq-body">
								<ul style="margin: 0; padding-left: 18px; display: grid; gap: 8px;">
									{product.limitations.map((item) => (
										<li>{item}</li>
									))}
								</ul>
							</div>
						</details>
					)}
				</div>
			</div>
		</section>
	</div>
</BaseLayout>
