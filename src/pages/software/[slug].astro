---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SOFTWARE_PRODUCTS, type SoftwareProduct } from '../../lib/software';
export function getStaticPaths() { return SOFTWARE_PRODUCTS.map(product => ({ params:{slug:product.slug}, props:{product} })); }
interface Props { product:SoftwareProduct; }
const { product } = Astro.props;
---
<BaseLayout title={`${product.name} — ${product.category}`} description={`${product.tagline}。${product.availabilitySummary}`} image={product.screenshot}>
  <header class="software-detail-hero"><div class="shell"><nav class="software-breadcrumb" aria-label="面包屑"><a href="/">首页</a><span aria-hidden="true">/</span><a href="/software/">作品与工具</a><span aria-hidden="true">/</span><span aria-current="page">{product.name}</span></nav>
    <div class="software-hero-top" data-reveal><div class="software-hero-copy"><div class="software-identity-row"><Image src={product.icon} alt="" width={72} height={72}/><div><span class="status-pill" data-tone={product.statusTone}>{product.statusBadge}</span><p class="small-label">{product.platformsLabel}</p></div></div><h1>{product.name}<br/>{product.headline}</h1><p class="software-hero-summary">{product.summary}</p><div class="brand-hero-actions"><a class="btn-primary" href={product.downloads.length ? '#downloads' : `/posts/${product.articleSlug}/`}>{product.downloads.length ? '下载与安装' : '阅读工程案例'} <span aria-hidden="true">↘</span></a>{product.repoVisibility==='public' && <a class="btn-secondary" href={product.repoUrl} target="_blank" rel="noopener noreferrer">公开源码 ↗</a>}</div></div>
    <aside class="acquisition-panel" aria-label="项目状态"><span class="small-label">截至 {product.verifiedAt}</span><h2>目前做到哪一步</h2><p>{product.availabilitySummary}</p><div class="acquisition-notice">{product.availabilityNotice}</div><p class="small-label">{product.contribution}</p></aside></div>
  </div></header>
  <section class="shell software-section" aria-labelledby="interface-heading"><div class="section-header-bar" data-reveal><div><span class="small-label">界面与来源</span><h2 id="interface-heading">{product.slug==='usblinkmic' ? '连接状态，看得见。' : '从一张卡片开始。'}</h2></div></div><figure><div class:list={['product-gallery',{single:!product.secondaryScreenshot}]}><Image src={product.screenshot} alt={product.screenshotAlt} widths={[640,960,1600]} sizes="(max-width: 760px) 90vw, 1000px"/>{product.secondaryScreenshot && <Image class="gallery-phone" src={product.secondaryScreenshot} alt="USBLinkMic Android 开发版真实界面，连接信息已遮盖" width={400}/>}</div><figcaption class="software-visual-caption">{product.screenshotCaption}</figcaption></figure>
    <dl class="version-table"><div><dt>最新公开版</dt><dd>{product.latestVersion}</dd></div><div><dt>当前开发状态</dt><dd>{product.developmentVersion}</dd></div><div><dt>本轮安装核对</dt><dd>{product.installedVersion}</dd></div></dl>
  </section>
  <section class="shell software-section" aria-labelledby="capabilities-heading"><div class="section-header-bar" data-reveal><div><span class="small-label">做什么 / 怎样做</span><h2 id="capabilities-heading">{product.tagline}</h2></div></div><div class="software-grid-2">{product.highlights.map(item=><article class="software-feature-card"><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></section>
  <section class="shell software-section" aria-labelledby="scenarios-heading"><div class="section-header-bar" data-reveal><h2 id="scenarios-heading">放进具体的使用场景</h2></div><div class="software-grid-3">{product.scenarios.map(item=><article class="software-scenario-card"><h3>{item.scenario}</h3><p>{item.pain}</p><p>{item.outcome}</p><p class="small-label">{item.mechanism}</p></article>)}</div></section>
  <section class="shell software-section" id="downloads" aria-labelledby="start-heading"><div class="section-header-bar" data-reveal><div><span class="small-label">开始之前</span><h2 id="start-heading">{product.downloads.length ? '选择公开安装包' : '目前以案例展示'}</h2><p>{product.availabilitySummary}</p></div></div>
    {product.downloads.length>0 && <div class="download-list">{product.downloads.map(item=><a class="download-item" href={item.url} target="_blank" rel="noopener noreferrer"><div class="download-item-main"><strong>{item.label}</strong><span>{item.platform} · {item.version}</span><span>{item.note}</span></div><span class="download-item-meta">{item.format} · {item.size} ↗</span></a>)}</div>}
    <div class="acquisition-links">{product.sources.map(source=><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} ↗</a>)}{product.checksumsUrl && <a href={product.checksumsUrl} target="_blank" rel="noopener noreferrer">SHA-256 校验文件 ↗</a>}</div>
    <div class="software-grid-3" style="margin-top:var(--space-8)">{product.workflow.map(step=><article class="software-step-card"><span class="step-badge">{step.step}</span><h3>{step.title}</h3><p>{step.description}</p><p class="small-label">{step.detail}</p></article>)}</div><dl class="software-specs-grid" style="margin-top:var(--space-6)">{product.specs.map(spec=><div class="spec-card"><dt>{spec.label}</dt><dd>{spec.value}</dd></div>)}</dl>
  </section>
  <section class="shell software-section" aria-labelledby="limits-heading"><div class="section-header-bar" data-reveal><h2 id="limits-heading">先把边界说清楚</h2></div><div class="evidence-note"><ul>{product.limitations.map(item=><li>{item}</li>)}</ul></div><div class="faq-list">{product.faq.map(item=><details class="faq-item"><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div><div class="related-article-banner"><div><span class="small-label">继续读 / 工程手记</span><h3>{product.articleTitle}</h3><p>问题怎么拆、组件怎么接，以及哪些结论还需要验证。</p></div><a class="btn-primary" href={`/posts/${product.articleSlug}/`}>阅读案例 →</a></div></section>
</BaseLayout>
