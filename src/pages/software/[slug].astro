---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SOFTWARE_PRODUCTS, type SoftwareProduct } from '../../lib/software';
export function getStaticPaths() { return SOFTWARE_PRODUCTS.map(product => ({ params:{slug:product.slug}, props:{product} })); }
interface Props { product:SoftwareProduct; }
const { product } = Astro.props;
---
<BaseLayout title={`${product.name} — ${product.category}`} description={`${product.tagline}。${product.availabilitySummary}`} image={product.screenshot}>
  <header class="software-detail-hero"><div class="shell"><nav class="software-breadcrumb" aria-label="面包屑"><a href="/">首页</a><span aria-hidden="true">/</span><a href="/software/">作品与工具</a><span aria-hidden="true">/</span><span aria-current="page">{product.name}</span></nav>
    <div class="software-hero-top" data-reveal><div class="software-hero-copy"><div class="software-identity-row"><Image src={product.icon} alt="" width={72} height={72} format="webp" densities={[1, 2]} decoding="async"/><div><span class="status-pill" data-tone={product.statusTone}>{product.statusBadge}</span><p class="small-label">{product.platformsLabel}</p></div></div><h1>{product.name}<br/>{product.headline}</h1><p class="software-hero-summary">{product.summary}</p><div class="brand-hero-actions"><a class="btn-primary" href={product.downloads.length ? '#downloads' : `/posts/${product.articleSlug}/`}>{product.downloads.length ? '下载与安装' : '阅读工程案例'} <span aria-hidden="true">↘</span></a>{product.repoVisibility==='public' && <a class="btn-secondary" href={product.repoUrl} target="_blank" rel="noopener noreferrer">公开源码 ↗</a>}</div></div>
    <aside class="acquisition-panel" aria-label="项目状态"><span class="small-label">截至 {product.verifiedAt}</span><h2>目前做到哪一步</h2><p>{product.availabilitySummary}</p><div class="acquisition-notice">{product.availabilityNotice}</div><p class="small-label">{product.contribution}</p></aside></div>
  </div></header>
  <section class="shell software-section" aria-labelledby="interface-heading"><div class="section-header-bar" data-reveal><div><span class="small-label">界面与来源</span><h2 id="interface-heading">{product.slug==='usblinkmic' ? '连接状态，看得见。' : '从一张卡片开始。'}</h2></div></div><figure><div data-glass-media class:list={['product-gallery',{single:!product.secondaryScreenshot}]} style={'view-transition-name: work-' + product.slug + '; --product-ratio: ' + (product.screenshot.width / product.screenshot.height).toFixed(5)}><Image src={product.screenshot} alt={product.screenshotAlt} widths={[640,960,1600]} sizes="(max-width: 760px) 90vw, 1000px" format="webp" loading="eager" fetchpriority="high" decoding="async"/>{product.secondaryScreenshot && <Image class="gallery-phone" src={product.secondaryScreenshot} alt="USBLinkMic Android 开发版真实界面，连接信息已遮盖" width={400} format="webp" decoding="async"/>}</div><figcaption class="software-visual-caption">{product.screenshotCaption}</figcaption></figure>
    <dl class="version-table"><div><dt>最新公开版</dt><dd>{product.latestVersion}</dd></div><div><dt>当前开发状态</dt><dd>{product.developmentVersion}</dd></div><div><dt>本轮安装核对</dt><dd>{product.installedVersion}</dd></div></dl>
  </section>

  {product.slug==='habitbloom' && (
    <section class="shell software-section habitbloom-technical" aria-labelledby="habitbloom-architecture">
      <div class="section-header-bar" data-reveal>
        <div><span class="small-label">工程实现 / 真实代码结构</span><h2 id="habitbloom-architecture">不止一张卡片：把数据、Widget 和远端连起来。</h2></div>
      </div>
      <p class="habitbloom-architecture-intro">以下是根据项目仓库绘制的技术示意，不是手机真实截图。代码路径、测试和未完成项均可在配套的工程文章中核对。</p>
      <div class="habitbloom-architecture-grid">
        <figure class="habitbloom-architecture-figure">
          <img src="/media/habitbloom/habitbloom-engineering-scope.svg" width="1200" height="675" loading="lazy" decoding="async" alt="HabitBloom 的 SwiftUI 本地记录、WidgetKit 交互和 Cloudflare 远程能力组成结构图" />
          <figcaption>01 · 技术栈与功能范围：已实现核心功能，但还没有公开安装包。</figcaption>
        </figure>
        <figure class="habitbloom-architecture-figure">
          <img src="/media/habitbloom/habitbloom-data-path.svg" width="1200" height="675" loading="lazy" decoding="async" alt="SwiftData 数据保存和 Widget 快照、App Group 及 Cloudflare 读取路径的示意图" />
          <figcaption>02 · 从 SwiftData 到 Widget 快照：允许本地优先，也保留侧载环境下的远程路径。</figcaption>
        </figure>
      </div>
    </section>
  )}

  {product.slug==='usblinkmic' && (
    <section class="shell software-section" aria-labelledby="usblinkmic-real-screenshots">
      <div class="section-header-bar" data-reveal>
        <div>
          <span class="small-label">真实界面 / USER-SUPPLIED SCREENSHOTS</span>
          <h2 id="usblinkmic-real-screenshots">不仅是一个窗口，还能实际管理麦克风与 USB 网络。</h2>
        </div>
      </div>
      <p class="usblinkmic-capture-notice">以下来自 v4.0.17 Mac 开发版实际截图，已遮盖设备标识。公开下载包与当前开发界面可能不同；局部状态显示“就绪”不代表已经完成全部音频或公网链路验收。</p>
      <div class="usblinkmic-real-gallery">
        <figure class="usblinkmic-real-shot">
          <a href="/media/usblinkmic/network.svg" target="_blank" rel="noopener noreferrer" aria-label="查看 USB 网络共享截图大图">
            <img src="/media/usblinkmic/network.svg" width="1100" height="829" loading="lazy" decoding="async" alt="Mac 开发版 USBLinkMic 网络共享页面，展示手机给 Mac、Mac 给手机两个方向，设备标识已遮盖" />
          </a>
          <figcaption><strong>01 / USB 网络共享</strong> 两个方向共享同一条 USB 链路，页面区分 NCM 就绪、路由与联网条件。</figcaption>
        </figure>
        <figure class="usblinkmic-real-shot">
          <a href="/media/usblinkmic/microphone.svg" target="_blank" rel="noopener noreferrer" aria-label="查看手机麦克风截图大图">
            <img src="/media/usblinkmic/microphone.svg" width="1100" height="829" loading="lazy" decoding="async" alt="Mac 开发版 USBLinkMic 手机麦克风页，展示 USB 或 Wi-Fi 通道和 BlackHole 音频输出配置" />
          </a>
          <figcaption><strong>02 / 手机麦克风</strong> 连接、传输通道、试听与虚拟麦克风输出集中管理；当前截图为尚未开始拾音的状态。</figcaption>
        </figure>
        <figure class="usblinkmic-real-shot usblinkmic-real-shot--menu">
          <a href="/media/usblinkmic/menu.svg" target="_blank" rel="noopener noreferrer" aria-label="查看菜单栏截图大图">
            <img src="/media/usblinkmic/menu.svg" width="676" height="462" loading="lazy" decoding="async" alt="USBLinkMic 菜单栏快捷控制，可启动麦克风、查看 USB 共享状态并打开主窗口" />
          </a>
          <figcaption><strong>03 / 菜单栏快捷入口</strong> 不打开主窗口也能查看连接状态并操作常用功能。</figcaption>
        </figure>
      </div>
    </section>
  )}
  <section class="shell software-section" aria-labelledby="capabilities-heading"><div class="section-header-bar" data-reveal><div><span class="small-label">做什么 / 怎样做</span><h2 id="capabilities-heading">{product.tagline}</h2></div></div><div class="software-grid-2">{product.highlights.map(item=><article class="software-feature-card"><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></section>
  <section class="shell software-section" aria-labelledby="scenarios-heading"><div class="section-header-bar" data-reveal><h2 id="scenarios-heading">放进具体的使用场景</h2></div><div class="software-grid-3">{product.scenarios.map(item=><article class="software-scenario-card"><h3>{item.scenario}</h3><p>{item.pain}</p><p>{item.outcome}</p><p class="small-label">{item.mechanism}</p></article>)}</div></section>
  <section class="shell software-section" id="downloads" aria-labelledby="start-heading"><div class="section-header-bar" data-reveal><div><span class="small-label">开始之前</span><h2 id="start-heading">{product.downloads.length ? '选择公开安装包' : '目前以案例展示'}</h2><p>{product.availabilitySummary}</p></div></div>
    {product.downloads.length>0 && <div class="download-list">{product.downloads.map(item=><a class="download-item" href={item.url} target="_blank" rel="noopener noreferrer"><div class="download-item-main"><strong>{item.label}</strong><span>{item.platform} · {item.version}</span><span>{item.note}</span></div><span class="download-item-meta">{item.format} · {item.size} ↗</span></a>)}</div>}
    <div class="acquisition-links">{product.sources.map(source=><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} ↗</a>)}{product.checksumsUrl && <a href={product.checksumsUrl} target="_blank" rel="noopener noreferrer">SHA-256 校验文件 ↗</a>}</div>
    <div class="software-grid-3" style="margin-top:var(--space-8)">{product.workflow.map(step=><article class="software-step-card"><span class="step-badge">{step.step}</span><h3>{step.title}</h3><p>{step.description}</p><p class="small-label">{step.detail}</p></article>)}</div><dl class="software-specs-grid" style="margin-top:var(--space-6)">{product.specs.map(spec=><div class="spec-card"><dt>{spec.label}</dt><dd>{spec.value}</dd></div>)}</dl>
  </section>
  <section class="shell software-section" aria-labelledby="limits-heading"><div class="section-header-bar" data-reveal><h2 id="limits-heading">先把边界说清楚</h2></div><div class="evidence-note"><ul>{product.limitations.map(item=><li>{item}</li>)}</ul></div><div class="faq-list">{product.faq.map(item=><details class="faq-item"><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div><div class="related-article-banner"><div><span class="small-label">继续读 / 工程手记</span><h3>{product.articleTitle}</h3><p>问题怎么拆、组件怎么接，以及哪些结论还需要验证。</p></div><a class="btn-primary" href={`/posts/${product.articleSlug}/`}>阅读案例 →</a></div></section>
</BaseLayout>

<style>
  .habitbloom-architecture-intro { max-width: 70ch; margin: 8px 0 28px; font-size: 14px; line-height: 1.8; color: var(--text-secondary); }
  .habitbloom-architecture-grid { display: grid; gap: 26px; grid-template-columns: repeat(2,minmax(0,1fr)); align-items: start; }
  .habitbloom-architecture-figure { margin: 0; min-width: 0; }
  .habitbloom-architecture-figure img { display: block; width: 100%; height: auto; aspect-ratio: 16/9; object-fit: contain; border: 1px solid var(--line); border-radius: 17px; background: #f7f2e8; }
  .habitbloom-architecture-figure figcaption { margin: 11px 2px 0; font-size: 12px; line-height: 1.7; color: var(--text-muted); }
  @media (max-width: 900px) {
    .habitbloom-architecture-grid { grid-template-columns: 1fr; gap: 24px; }
    .habitbloom-architecture-figure { max-width: 780px; }
  }
</style>

<style>
  .usblinkmic-capture-notice { margin: 0 0 24px; max-width: 78ch; color: var(--text-secondary); font-size: 13.5px; line-height: 1.8; }
  .usblinkmic-real-gallery { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 26px; align-items: start; }
  .usblinkmic-real-shot { margin:0; min-width:0; }
  .usblinkmic-real-shot a { display:block; overflow:hidden; border: 1px solid var(--line); border-radius: 16px; background: var(--surface-subtle); }
  .usblinkmic-real-shot img { display:block; width:100%; height:auto; }
  .usblinkmic-real-shot figcaption { margin:11px 2px 0; font-size:12.5px; line-height:1.75; color:var(--text-secondary); }
  .usblinkmic-real-shot figcaption strong { font-weight:700; color:var(--text); }
  .usblinkmic-real-shot--menu { max-width:500px; }
  @media (max-width: 850px) { .usblinkmic-real-gallery { grid-template-columns:1fr; gap:24px; } }
</style>
