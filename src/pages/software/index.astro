---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryCard from '../../components/GalleryCard.astro';
import { SOFTWARE_PRODUCTS, WORKBENCH_PROJECTS } from '../../lib/software';
---
<BaseLayout title="软件与作品" description="Xin 的软件作品与工程实践：真实界面、开发记录、公开安装包与验证边界。">
  <header class="shell gallery-hero">
    <div class="gallery-hero-topline"><span>MYZJX / WORK & EXPERIMENTS</span><span class="gallery-status-light">独立开发的项目</span></div>
    <h1>软件与项目作品集</h1>
    <p class="gallery-hero-description">已公开的软件、尚在完善的原型，以及值得记下来的开发实践。每张卡片都通向自己的项目详情，标明真实的发布与验证状态。</p>
    <div class="gallery-hero-bottom"><div class="gallery-hero-links"><a href="#software-gallery">浏览全部作品 ↘</a><a href="/posts/">查看工程手记 ↗</a></div><span class="gallery-status-light">{SOFTWARE_PRODUCTS.length+WORKBENCH_PROJECTS.length} 个项目与实践</span></div>
    <div class="gallery-index-rule"></div>
  </header>
  <section class="shell gallery-section" id="software-gallery">
    <div class="gallery-section-heading"><h2>作品与实验</h2><small>产品、工作台与工程方法</small></div>
    <div class="gallery-grid">
      {SOFTWARE_PRODUCTS.map((product,index)=>(
        <div class="gallery-item" data-reveal>
          <GalleryCard href={'/software/'+product.slug+'/'} title={product.name}
            description={product.summary} category={product.platformsLabel}
            meta={product.statusBadge} image={product.screenshot} tone="tool" index={index}
            transitionKey={'work-'+product.slug} />
        </div>
      ))}
      {WORKBENCH_PROJECTS.map((project,index)=>(
        <div class="gallery-item" data-reveal>
          <GalleryCard href={project.href} title={project.name} description={project.summary}
            category="工作台 / 实践" meta={project.status} tone="project"
            index={index+SOFTWARE_PRODUCTS.length} />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
