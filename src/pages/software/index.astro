---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SOFTWARE_PRODUCTS, WORKBENCH_PROJECTS } from '../../lib/software';
import ProductVisual from '../../components/ProductVisual.astro';
const usb = SOFTWARE_PRODUCTS[0];
const habit = SOFTWARE_PRODUCTS[1];
---
<BaseLayout title="作品与工具" description="Xin 的软件作品与工程实践。USBLinkMic 提供公开双端安装包，HabitBloom 与浏览器工具以开发案例展示。">
  <header class="shell page-heading"><div class="section-kicker">WORK / 作品与工具</div><h1>做出来，也说明白。</h1><p>有些工具已经可以下载，有些还在自己的工作台上。这里保留它们解决的问题、真实界面，以及目前做到哪一步。</p></header>
  <section class="shell maker-section" style="padding-top:32px" aria-labelledby="public-work">
    <div class="folio-label"><span id="public-work">01 / 公开作品</span><span>可下载 · 可查看源码</span></div>
    <article class="flagship"><div class="flagship-copy"><div class="app-identity"><Image src={usb.icon} alt="" width={56} height={56}/><h2>{usb.name}</h2></div><h3>{usb.headline}</h3><p>{usb.tagline}。把散落的连接命令、依赖检查和状态提示收进原生面板。</p><div class="release-line"><span class="status-pill" data-tone="release">{usb.statusBadge}</span><span>{usb.platformsLabel}</span></div><a class="btn-primary" href="/software/usblinkmic/">作品、下载与使用边界 ↗</a></div><div class="flagship-art"><ProductVisual product={usb}/><p class="visual-provenance">4.0.10 开发版真实界面 · 公开下载为 v4.0.8</p></div></article>
  </section>
  <section class="shell maker-section" style="padding-top:0" aria-labelledby="private-work"><div class="folio-heading"><div><span class="small-label">02 / 工作台</span><h2 id="private-work">正在生长的尝试</h2></div></div>
    <article class="bloom-preview"><div class="bloom-mark"><Image src={habit.icon} alt="HabitBloom 项目图标" width={150} height={150}/></div><div><span class="small-label">{habit.statusBadge}</span><h3>HabitBloom</h3><p>{habit.summary}</p><a class="text-link" href="/software/habitbloom/">看设计与限制 →</a></div></article>
    <div class="work-grid">{WORKBENCH_PROJECTS.map(p=><article class="work-card"><span class="small-label">{p.status}</span><h3>{p.name}</h3><p>{p.summary}</p><a class="text-link" href={p.href}>阅读实践记录 ↗</a></article>)}</div>
  </section>
</BaseLayout>
