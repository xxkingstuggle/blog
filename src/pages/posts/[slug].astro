---
import { getPublishedPosts } from '../../lib/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleTemplate from '../../components/article/ArticleTemplate.astro';
import FeatureTemplate from '../../components/article/FeatureTemplate.astro';
import { render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	const listedPosts = posts.filter((post) => post.data.listed !== false);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: {
			post,
			nextPost: listedPosts.find((candidate) => candidate.data.pubDate.valueOf() < post.data.pubDate.valueOf()) ?? null,
		},
	}));
}

const { post, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const description = post.data.description;
const isFeature = post.data.presentation === 'feature';
---

<BaseLayout
	title={post.data.title}
	description={description}
	image={post.data.cover}
	ogType="article"
	noindex={false}
>
	{isFeature ? (
		<FeatureTemplate post={post} headings={headings} nextPost={nextPost}>
			<Content />
		</FeatureTemplate>
	) : (
		<ArticleTemplate post={post} headings={headings} nextPost={nextPost}>
			<Content />
		</ArticleTemplate>
	)}
</BaseLayout>
