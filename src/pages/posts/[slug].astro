---
import { getPublishedPosts } from '../../lib/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleTemplate from '../../components/article/ArticleTemplate.astro';
import FeatureTemplate from '../../components/article/FeatureTemplate.astro';
import { render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	const listedPosts = posts.filter((post) => post.data.listed !== false);
	return posts.map((post) => {
		const listedIndex = listedPosts.findIndex((candidate) => candidate.id === post.id);
		let prevPost = null;
		let nextPost = null;
		if (listedIndex !== -1) {
			prevPost = listedIndex > 0 ? listedPosts[listedIndex - 1] : null;
			nextPost = listedIndex < listedPosts.length - 1 ? listedPosts[listedIndex + 1] : null;
		} else {
			const postTime = post.data.pubDate.valueOf();
			nextPost = listedPosts.find((candidate) => candidate.data.pubDate.valueOf() < postTime) ?? null;
			const newerCandidates = listedPosts.filter((candidate) => candidate.data.pubDate.valueOf() > postTime);
			prevPost = newerCandidates.length > 0 ? newerCandidates[newerCandidates.length - 1] : null;
		}
		return {
			params: { slug: post.id },
			props: {
				post,
				prevPost,
				nextPost,
			},
		};
	});
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const description = post.data.description;
const isFeature = post.data.presentation === 'feature';
---

<BaseLayout
	title={post.data.title}
	description={description}
	image={post.data.cover}
	ogType="article"
	noindex={post.data.listed === false}
>
	{isFeature ? (
		<FeatureTemplate post={post} headings={headings} prevPost={prevPost} nextPost={nextPost}>
			<Content />
		</FeatureTemplate>
	) : (
		<ArticleTemplate post={post} headings={headings} prevPost={prevPost} nextPost={nextPost}>
			<Content />
		</ArticleTemplate>
	)}
</BaseLayout>
