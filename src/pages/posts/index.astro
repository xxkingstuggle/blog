---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryCard from '../../components/GalleryCard.astro';
import { getListedPosts, KIND_LABELS, formatDate, getReadingTime } from '../../lib/posts';

const posts = await getListedPosts();
const usedCoverSources = new Set<string>();
function previewForPost(post: (typeof posts)[number]) {
  const cover = post.data.cover;
  if (!cover || usedCoverSources.has(cover.src)) return undefined;
  usedCoverSources.add(cover.src);
  return cover;
}
const filters = ['all', 'project', 'thought', 'update'] as const;
---

<BaseLayout title="文章与手记" description="Xin 的工程复盘、软件开发手记与日常思考，按时间排列。">
	<header class="shell page-heading gallery-journal-heading" data-reveal>
		<div class="section-kicker">
			<span class="kicker-dot" aria-hidden="true"></span>
			<span>JOURNAL & ENGINEERING NOTES / 文章与手记</span>
		</div>
		<h1>文章与手记</h1>
		<p>记录个人软件的架构取舍、真实开发里的踩坑排查，以及工作之外的自省与观察。</p>
	</header>

	<section class="shell posts-section" aria-label="文章索引">
		<div class="index-tools">
			<div class="index-filters" role="group" aria-label="按分类筛选文章">
				{filters.map((filter) => (
					<button
						type="button"
						class="index-filter"
						data-filter={filter}
						aria-pressed={filter === 'all'}
					>
						<span>{filter === 'all' ? '全部' : KIND_LABELS[filter]}</span>
						<span class="index-filter-count">
							{filter === 'all' ? posts.length : posts.filter((post) => post.data.kind === filter).length}
						</span>
					</button>
				))}
			</div>
			<div class="index-search" role="search">
				<span aria-hidden="true">⌕</span>
				<input
					type="search"
					id="post-search"
					aria-label="搜索文章标题、摘要或标签"
					placeholder="搜索标题、关键词或标签… (按 / 聚焦)"
				/>
				<button
					type="button"
					id="post-search-clear"
					class="index-search-clear"
					aria-label="清空搜索词"
					hidden
				>
					×
				</button>
			</div>
		</div>

		<p class="index-count" id="index-count" role="status" aria-live="polite">
			共 {posts.length} 篇已发布文章
		</p>

		<div id="posts-list" class="gallery-grid">
			{posts.map((post, index) => (
				<div
					class="post-index-item gallery-item"
					data-kind={post.data.kind}
					data-search={[post.data.title, post.data.description, ...post.data.tags].join(' ').toLocaleLowerCase()}
				>
					<GalleryCard
						href={'/posts/' + post.id + '/'}
						title={post.data.title}
						description={post.data.description}
						category={KIND_LABELS[post.data.kind]}
						image={previewForPost(post)}
						video={post.data.video}
						videoPoster={post.data.videoPoster}
						tone={post.data.kind === 'thought' ? 'thinking' : post.data.kind}
						meta={formatDate(post.data.pubDate) + ' · ' + getReadingTime(post.body)}
						index={index}
						transitionKey={'article-' + post.id}
					/>
				</div>
			))}
		</div>

		<div id="posts-empty" class="index-empty" hidden>
			<p>没有找到匹配的文章。试试清除搜索词或切换上方分类。</p>
			<button type="button" id="posts-reset" class="index-empty-reset" data-filter="all">
				清除筛选条件
			</button>
		</div>
	</section>
</BaseLayout>

<style>
	.posts-section {
		padding: var(--space-8) 0 var(--space-16);
	}
	.index-tools {
		display: flex;
		justify-content: space-between;
		gap: var(--space-6);
		flex-wrap: wrap;
		align-items: center;
		padding: var(--space-4) var(--space-6);
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
	}
	.index-filters {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.index-filter {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 38px;
		border: 1px solid transparent;
		padding: 7px 14px;
		border-radius: var(--radius-pill);
		background: transparent;
		font-size: 13.5px;
		font-weight: 500;
		cursor: pointer;
		color: var(--text-secondary);
		transition: background-color var(--duration-fast) ease, color var(--duration-fast) ease, border-color var(--duration-fast) ease;
	}
	.index-filter:hover {
		background: var(--surface-subtle);
		color: var(--text);
	}
	.index-filter[aria-pressed="true"] {
		background: var(--text);
		color: var(--bg);
		border-color: var(--text);
		font-weight: 600;
	}
	.index-filter-count {
		font-family: var(--font-mono);
		font-size: 11px;
		opacity: 0.78;
	}
	.index-search {
		display: flex;
		align-items: center;
		gap: 8px;
		min-height: 40px;
		padding: 2px 4px 2px 12px;
		border: 1px solid var(--line);
		border-radius: var(--radius-pill);
		background: var(--bg);
		color: var(--text-muted);
	}
	.index-search input {
		background: none;
		border: 0;
		padding: 4px 0;
		font-size: 13.5px;
		width: 220px;
		color: var(--text);
	}
	.index-search input:focus {
		outline: none;
	}
	.index-search:focus-within {
		border-color: var(--accent-contrast);
	}
	.index-search-clear {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: var(--surface-subtle);
		color: var(--text-secondary);
		font-size: 15px;
		line-height: 1;
		cursor: pointer;
		flex-shrink: 0;
	}
	.index-search-clear:hover {
		background: var(--text);
		color: var(--bg);
	}
	.index-search-clear[hidden] {
		display: none;
	}
	.index-count {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--text-muted);
		margin: var(--space-6) 0 var(--space-1);
	}
	.index-empty {
		color: var(--text-muted);
		text-align: center;
		padding: 64px 20px;
		background: var(--surface);
		border: 1px dashed var(--line);
		border-radius: var(--radius-md);
		margin-top: 20px;
	}
	.index-empty p {
		margin: 0 0 14px;
	}
	.index-empty-reset {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 38px;
		padding: 8px 16px;
		border-radius: var(--radius-pill);
		border: 1px solid var(--line);
		background: var(--bg);
		color: var(--text);
		font-size: 13px;
		font-weight: 600;
		cursor: pointer;
		transition: border-color var(--duration-fast) ease, background-color var(--duration-fast) ease;
	}
	.index-empty-reset:hover {
		border-color: var(--text);
		background: var(--surface-subtle);
	}
	.post-index-item[hidden],
	.index-empty[hidden] {
		display: none;
	}
	@media (max-width: 720px) {
		.index-tools {
			padding: var(--space-4);
		}
		.index-filter {
			min-height: 40px;
		}
		.index-search {
			width: 100%;
			min-height: 44px;
		}
		.index-search input {
			width: 100%;
			font-size: 16px;
		}
	}
</style>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('.index-filter[data-filter]');
	const items = document.querySelectorAll<HTMLElement>('.post-index-item');
	const search = document.getElementById('post-search') as HTMLInputElement | null;
	const clearBtn = document.getElementById('post-search-clear') as HTMLButtonElement | null;
	const resetBtn = document.getElementById('posts-reset') as HTMLButtonElement | null;
	const count = document.getElementById('index-count');
	const empty = document.getElementById('posts-empty');
	const validKinds = new Set(['all', 'project', 'thought', 'update']);
	let activeFilter = 'all';

	function syncButtons() {
		buttons.forEach((item) =>
			item.setAttribute('aria-pressed', String((item.dataset.filter ?? 'all') === activeFilter))
		);
	}

	function syncUrl(rawQuery: string) {
		const params = new URLSearchParams(window.location.search);
		if (activeFilter !== 'all') params.set('kind', activeFilter);
		else params.delete('kind');
		if (rawQuery) params.set('q', rawQuery);
		else params.delete('q');
		const query = params.toString();
		const nextUrl = query ? `${window.location.pathname}?${query}` : window.location.pathname;
		if (nextUrl !== `${window.location.pathname}${window.location.search}`) {
			window.history.replaceState(null, '', nextUrl);
		}
	}

	function updateIndex(syncHistory = true) {
		const rawQuery = search?.value.trim() ?? '';
		const term = rawQuery.toLocaleLowerCase();
		if (clearBtn) clearBtn.hidden = (search?.value.length ?? 0) === 0;
		let visible = 0;
		items.forEach((item) => {
			item.hidden = !(
				(activeFilter === 'all' || item.dataset.kind === activeFilter) &&
				(item.dataset.search ?? '').includes(term)
			);
			if (!item.hidden) visible++;
		});
		if (count) count.textContent = `共 ${visible} 篇已发布文章`;
		if (empty) empty.hidden = visible !== 0;
		if (syncHistory) syncUrl(rawQuery);
	}

	const initialParams = new URLSearchParams(window.location.search);
	const initialKind = initialParams.get('kind');
	const initialQuery = initialParams.get('q');
	if (initialKind && validKinds.has(initialKind)) {
		activeFilter = initialKind;
		syncButtons();
	}
	if (initialQuery && search) {
		search.value = initialQuery;
	}
	if (initialKind || initialQuery) {
		updateIndex(false);
	}

	buttons.forEach((button) =>
		button.addEventListener('click', () => {
			activeFilter = button.dataset.filter ?? 'all';
			syncButtons();
			updateIndex();
		})
	);
	search?.addEventListener('input', () => updateIndex());
	clearBtn?.addEventListener('click', () => {
		if (!search) return;
		search.value = '';
		updateIndex();
		search.focus();
	});
	resetBtn?.addEventListener('click', () => {
		activeFilter = 'all';
		if (search) search.value = '';
		syncButtons();
		updateIndex();
	});
	document.addEventListener('keydown', (event) => {
		if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
		const active = document.activeElement as HTMLElement | null;
		const tag = active?.tagName;
		if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || active?.isContentEditable) return;
		event.preventDefault();
		search?.focus();
		search?.select();
	});
</script>
