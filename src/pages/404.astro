---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到 (404)" description="你访问的页面不存在或已迁移。">
	<section class="shell" style="padding: clamp(72px, 14vh, 140px) 0;">
		<div class="related-article-banner" style="flex-direction: column; align-items: flex-start; max-width: 680px; margin-inline: auto;">
			<div class="section-kicker">
				<span class="kicker-dot" aria-hidden="true"></span>
				<span>404 NOT FOUND / 页面未找到</span>
			</div>
			<h1 style="font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 2.8rem); margin: 0 0 12px;">
				这个地址暂时没有内容
			</h1>
			<p style="font-size: 15px; color: var(--text-secondary); line-height: 1.75; margin-bottom: 24px;">
				请检查链接拼写是否有误，或直接前往软件产品官网页与文章索引。
			</p>
			<div class="brand-hero-actions" style="margin-bottom: 0;">
				<a class="btn-primary" href="/">返回首页</a>
				<a class="btn-secondary" href="/software/">浏览软件与工具</a>
				<a class="btn-secondary" href="/posts/">阅读全部文章</a>
			</div>
		</div>
	</section>
</BaseLayout>
