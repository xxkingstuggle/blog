---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="你访问的页面不存在。">
	<section class="shell not-found">
		<p class="not-found-code">404</p>
		<h1>页面不存在</h1>
		<p>这个地址没有对应的内容，回首页看看吧。</p>
		<a class="button-link" href="/">回到首页</a>
	</section>
</BaseLayout>
