---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleRow from '../components/ArticleRow.astro';
import { getListedPosts } from '../lib/posts';

const posts = await getListedPosts();
const years = [...new Set(posts.map((post) => post.data.pubDate.getFullYear()))];
---

<BaseLayout title="时间归档" description="按年份编排的所有已发布文章与工程手记归档。">
	<header class="shell page-heading">
		<div class="section-kicker">
			<span class="kicker-dot" aria-hidden="true"></span>
			<span>CHRONOLOGY / 时间归档</span>
		</div>
		<h1>按年份归档</h1>
		<p>共收录 {posts.length} 篇公开发布的项目记录、技术实践与思考文章。</p>
	</header>

	<section class="shell" style="padding: 40px 0 80px;">
		{years.map((year) => {
			const yearPosts = posts.filter((post) => post.data.pubDate.getFullYear() === year);
			return (
				<section style="margin-bottom: 48px;" aria-labelledby={`year-${year}`}>
					<div style="display: flex; align-items: baseline; justify-content: space-between; padding-bottom: 12px; border-bottom: 2px solid var(--text);">
						<h2 id={`year-${year}`} style="font-family: var(--font-mono); font-size: 1.5rem; margin: 0;">
							{year}
						</h2>
						<span style="font-family: var(--font-mono); font-size: 12px; color: var(--text-muted);">
							{yearPosts.length} 篇
						</span>
					</div>
					<div>
						{yearPosts.map((post, index) => (
							<ArticleRow post={post} index={index} />
						))}
					</div>
				</section>
			);
		})}
	</section>
</BaseLayout>
