---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import { getListedPosts } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getListedPosts();
	const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
	return tags.map((tag) => ({
		params: { tag },
		props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
	}));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`带有“${tag}”标签的文章。`}>
	<section class="shell" style="padding: clamp(60px, 8vw, 96px) 0 40px;">
		<a class="article-back-link" href="/tags/">
			<span aria-hidden="true">←</span>
			<span>返回所有标签</span>
		</a>
		<div class="hero-eyebrow" style="color: var(--accent-contrast);">TAG INDEX</div>
		<h1 style="font-size: clamp(2.4rem, 5vw, 3.6rem); font-weight: 800; letter-spacing: -0.035em; margin-bottom: 16px;">
			#{tag}
		</h1>
		<p style="font-size: 1.15rem; color: var(--text-muted); max-width: 54ch; line-height: 1.6; margin: 0;">
			共收录 {posts.length} 篇相关文章。
		</p>
	</section>

	<section class="shell" style="padding-bottom: 100px;" aria-label={`标签 ${tag} 下的文章`}>
		<div class="editorial-list" role="feed">
			{posts.map((post, i) => (
				<ArticleRow post={post} index={i} />
			))}
		</div>
	</section>
</BaseLayout>
