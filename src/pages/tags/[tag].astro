---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import { getListedPosts } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getListedPosts();
	const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
	return tags.map((tag) => ({
		params: { tag },
		props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
	}));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：#${tag}`} description={`带有“${tag}”标签的工程与思考文章。`}>
	<header class="shell page-heading">
		<a class="article-back-link" href="/tags/" style="margin-bottom: 16px;">
			<span aria-hidden="true">←</span>
			<span>返回全部标签</span>
		</a>
		<div class="section-kicker">
			<span class="kicker-dot" aria-hidden="true"></span>
			<span>TAG / 主题聚合</span>
		</div>
		<h1>#{tag}</h1>
		<p>共收录 {posts.length} 篇与「{tag}」相关的文章。</p>
	</header>

	<section class="shell" style="padding: 24px 0 88px;" aria-label={`标签 ${tag} 下的文章`}>
		<div role="feed">
			{posts.map((post, i) => (
				<ArticleRow post={post} index={i} />
			))}
		</div>
	</section>
</BaseLayout>
