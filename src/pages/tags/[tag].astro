---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
	return tags.map((tag) => ({
		params: { tag },
		props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
	}));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`带有“${tag}”标签的文章。`}>
	<section class="shell page-intro">
		<a class="back-link" href="/tags/">← 全部标签</a>
		<p class="eyebrow">TAG</p>
		<h1>#{tag}</h1>
		<p class="lede">{posts.length} 篇文章</p>
	</section>
	<section class="shell section-block">
		<div class="post-list">
			{posts.map((post) => <PostCard post={post} />)}
		</div>
	</section>
</BaseLayout>
