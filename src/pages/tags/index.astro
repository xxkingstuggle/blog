---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getPosts } from '../../lib/posts';

const tags = getAllTags(await getPosts());
---

<BaseLayout title="标签" description="按标签浏览文章。">
	<section class="shell page-intro">
		<p class="eyebrow">TAGS</p>
		<h1>标签</h1>
		<p class="lede">从一个关键词开始浏览。</p>
	</section>
	<section class="shell section-block">
		<div class="tag-cloud">
			{tags.map((tag) => <a class="tag tag-large" href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
		</div>
	</section>
</BaseLayout>
