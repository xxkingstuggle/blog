---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminEditor from '../../components/admin/AdminEditor.astro';
import AdminComments from '../../components/admin/AdminComments.astro';
import AdminLinks from '../../components/admin/AdminLinks.astro';
import '../../styles/admin.css';
---

<BaseLayout title="内容后台" description="Xin 的发布后台。" noindex>
	<section class="shell admin-page" aria-labelledby="admin-heading">
		<div class="hero-eyebrow" style="color: var(--accent-contrast);">EDITORIAL CMS / 后台</div>
		<div class="admin-heading-row">
			<div>
				<h1 id="admin-heading">发布工作台</h1>
				<p>草稿先保存到 D1，发布时写入 GitHub；部署完成并核对 commit SHA 后才会显示已发布。</p>
			</div>
			<div class="admin-session-actions">
				<span class="admin-status" id="admin-status" role="status" aria-live="polite">正在连接…</span>
				<button type="button" class="admin-small-button" id="logout">退出</button>
			</div>
		</div>

		<!-- 栏目切换标签 -->
		<div class="admin-tabs" role="tablist" aria-label="后台管理导航">
			<button type="button" class="admin-tab-btn" id="tab-btn-posts" data-tab="posts" role="tab" aria-selected="true" aria-controls="tab-panel-posts" tabindex="0">
				文章
			</button>
			<button type="button" class="admin-tab-btn" id="tab-btn-comments" data-tab="comments" role="tab" aria-selected="false" aria-controls="tab-panel-comments" tabindex="-1">
				评论
			</button>
			<button type="button" class="admin-tab-btn" id="tab-btn-links" data-tab="links" role="tab" aria-selected="false" aria-controls="tab-panel-links" tabindex="-1">
				友链
			</button>
		</div>

		<!-- 1. 文章编辑器面板 -->
		<div class="admin-tab-panel" id="tab-panel-posts" role="tabpanel" aria-labelledby="tab-btn-posts">
			<AdminEditor />
		</div>

		<!-- 2. 评论管理面板 -->
		<div class="admin-tab-panel" id="tab-panel-comments" role="tabpanel" aria-labelledby="tab-btn-comments" hidden>
			<AdminComments />
		</div>

		<!-- 3. 友链管理面板 -->
		<div class="admin-tab-panel" id="tab-panel-links" role="tabpanel" aria-labelledby="tab-btn-links" hidden>
			<AdminLinks />
		</div>

		<!-- 页面底部可见状态提示浮动栏 -->
		<aside class="admin-bottom-dock" id="admin-bottom-dock" aria-live="polite">
			<div class="admin-dock-main">
				<span class="admin-dock-indicator info" id="admin-dock-indicator"></span>
				<span class="admin-dock-text" id="admin-dock-text">正在连接…</span>
			</div>
			<a class="admin-dock-link" id="admin-dock-link" hidden></a>
		</aside>
	</section>
</BaseLayout>

<script src="../../scripts/admin.ts"></script>
