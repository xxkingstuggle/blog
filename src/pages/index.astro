---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import FeaturedStory from '../components/home/FeaturedStory.astro';
import EditorialIndex from '../components/home/EditorialIndex.astro';
import HomeProjects from '../components/home/HomeProjects.astro';
import HomeAbout from '../components/home/HomeAbout.astro';
import { getPosts, getFeaturedPost } from '../lib/posts';

const posts = await getPosts();
const featuredPost = await getFeaturedPost();
---

<BaseLayout isHeroPage={true}>
	<HomeHero featuredPostSlug={featuredPost?.id} />
	{featuredPost && <FeaturedStory post={featuredPost} />}
	<EditorialIndex posts={posts} />
	<HomeProjects />
	<HomeAbout />
</BaseLayout>
