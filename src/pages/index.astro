---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getListedPosts, formatDate, getReadingTime, KIND_LABELS } from '../lib/posts';
import { siteConfig } from '../config';

const posts = await getListedPosts();
const projects = posts.filter((post) => post.data.kind === 'project' && post.data.cover && post.id !== 'lightweight-multi-agent-coding-loop');
const projectIds = new Set(projects.map((post) => post.id));
const journal = posts.filter((post) => !projectIds.has(post.id)).slice(0, 5);
const projectDetails: Record<string, { name: string; summary: string; platform: string; repo: string }> = {
  'habitbloom-habit-tracker': { name: 'HabitBloom', summary: '把每天的小习惯，放进一张愿意点开的卡片。', platform: 'iPhone · iPad · Mac', repo: 'HabitBloom' },
  'usblinkmic-android-mac-bridge': { name: 'USBLinkMic', summary: '一根 USB 线，让 Android 手机成为 Mac 的麦克风和网卡。', platform: 'macOS · Android', repo: 'USBLinkMic' },
};
---

<BaseLayout description="我是 Xin，做个人软件和工具，也写技术实践与生活里的想法。">
  <div class="shell journal-home">
    <section class="home-intro" aria-labelledby="intro-heading">
      <div class="intro-main">
        <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> 个人主页 / MYZJX.COM</p>
        <h1 id="intro-heading">我是 Xin，<br />做点<span class="ink-underline">有用的东西。</span></h1>
        <p class="intro-description">写代码，做工具，也记录一路遇到的问题。<br class="desktop-break" />这里收着我的个人项目、技术实践和一些想法。</p>
        <div class="intro-links">
          <a class="text-link" href="#projects">看看我的作品 <span aria-hidden="true">↗</span></a>
          <a href="/about/">更多关于我 <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <aside class="desk-note" aria-label="这个站点的内容">
        <div class="note-top"><span>我的小工作台</span><span aria-hidden="true">↙</span></div>
        <div class="note-letter" aria-hidden="true">Xin<span>.</span></div>
        <p>有些想法，<br />动手做了才知道。</p>
        <div class="note-bottom"><span>做工具 / 写东西 / 慢慢来</span><span aria-hidden="true">✳</span></div>
      </aside>
    </section>

    <section class="work-section" id="projects" aria-labelledby="work-heading">
      <div class="section-heading">
        <div><p class="eyebrow">01 / SELECTED WORK</p><h2 id="work-heading">最近做的东西<span class="heading-dot">.</span></h2></div>
        <a class="quiet-link" href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </div>
      <div class="work-grid">
        {projects.map((post, index) => {
          const detail = projectDetails[post.id];
          return <article class="work-card">
            <a class:list={['work-cover', { 'work-cover-app': post.id === 'habitbloom-habit-tracker' }]} href={`/posts/${post.id}/`} aria-label={`了解 ${detail?.name ?? post.data.title}`}>
              {post.data.cover && <Image src={post.data.cover} alt={`${detail?.name ?? post.data.title} 项目展示`} width={960} height={600} loading="lazy" />}
              <span class="work-number" aria-hidden="true">0{index + 1}</span>
              <span class="work-open" aria-hidden="true">↗</span>
            </a>
            <div class="work-caption">
              <div class="work-title-row"><h3><a href={`/posts/${post.id}/`}>{detail?.name ?? post.data.title.split('：')[0]}</a></h3><span>{detail?.platform ?? post.data.tags.slice(0, 2).join(' · ')}</span></div>
              <p>{detail?.summary ?? post.data.description}</p>
              <div class="work-links"><a href={`/posts/${post.id}/`}>项目记录 <span aria-hidden="true">→</span></a>{detail && <a href={`https://github.com/xxkingstuggle/${detail.repo}`} target="_blank" rel="noopener noreferrer">查看源码 <span aria-hidden="true">↗</span></a>}</div>
            </div>
          </article>;
        })}
        {projects.length === 0 && <p class="empty-copy">新的作品还在路上，先去读读文章吧。</p>}
      </div>
    </section>

    <section class="journal-section" id="latest" aria-labelledby="journal-heading">
      <div class="section-heading">
        <div><p class="eyebrow">02 / THE JOURNAL</p><h2 id="journal-heading">写下来，慢慢想<span class="heading-dot">.</span></h2></div>
        <a class="quiet-link" href="/posts/">全部文章 <span aria-hidden="true">→</span></a>
      </div>
      <div class="journal-list">
        {journal.map((post) => <a class="journal-entry" href={`/posts/${post.id}/`}>
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <div class="journal-entry-main"><span class="entry-kind">{KIND_LABELS[post.data.kind]}</span><h3>{post.data.title}</h3><p>{post.data.description}</p></div>
          <span class="entry-reading">{getReadingTime(post.body)} <span aria-hidden="true">↗</span></span>
        </a>)}
      </div>
    </section>

    <section class="home-contact" aria-labelledby="contact-heading">
      <p class="eyebrow">保持联系 / STAY IN THE LOOP</p>
      <h2 id="contact-heading">下次更新，<br class="mobile-break" />我们再见。</h2>
      <div><p>不定期写一点新的东西。<br />用 RSS 订阅，或到 GitHub 找我。</p><div class="contact-links"><a class="solid-link" href="/rss.xml">订阅 RSS <span aria-hidden="true">↗</span></a><a class="text-link" href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></div></div>
    </section>
  </div>
</BaseLayout>
