---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryCard from '../components/GalleryCard.astro';
import { getListedPosts, formatDate, getReadingTime, KIND_LABELS } from '../lib/posts';
import { SOFTWARE_PRODUCTS, WORKBENCH_PROJECTS } from '../lib/software';
import { siteConfig } from '../config';
const posts = (await getListedPosts()).slice(0, 7);
const usb = SOFTWARE_PRODUCTS[0];
const habit = SOFTWARE_PRODUCTS[1];
const workbench = WORKBENCH_PROJECTS.slice(0, 3);
const total = posts.length + 2 + workbench.length;
---
<BaseLayout title="Xin 的作品与手记" description={siteConfig.description} image={usb.screenshot}>
  <header class="shell gallery-hero" data-reveal>
    <div class="gallery-hero-topline">
      <span>MYZJX / A PERSONAL DESIGN & ENGINEERING STUDIO</span>
      <span class="gallery-status-light">独立创作中</span>
    </div>
    <h1>从好奇开始，<br /><em>把想法做出来。</em></h1>
    <p class="gallery-hero-description">
      你好，我是 Xin。这里收藏我做的软件、解决过的问题，以及还在探索中的想法。
      选择一张卡片，看看它从哪里开始，又走到了哪一步。
    </p>
    <div class="gallery-hero-bottom">
      <div class="gallery-hero-links">
        <a href="#explore">开始探索 <span aria-hidden="true">↘</span></a>
        <a href="/about/">关于我 <span aria-hidden="true">↗</span></a>
      </div>
      <span class="gallery-status-light">{total} 项公开记录 / 持续更新</span>
    </div>
    <div class="gallery-index-rule"></div>
  </header>

  <section class="shell gallery-section" id="explore" aria-labelledby="explore-title">
    <div class="gallery-section-heading">
      <div>
        <p class="eyebrow">THE COLLECTION / 作品集</p>
        <h2 id="explore-title">值得留下的作品与记录</h2>
      </div>
      <div class="gallery-view-tabs" role="group" aria-label="筛选公开内容">
        <button type="button" data-gallery-filter="all" aria-pressed="true">全部</button>
        <button type="button" data-gallery-filter="work" aria-pressed="false">软件与工具</button>
        <button type="button" data-gallery-filter="writing" aria-pressed="false">文章与手记</button>
      </div>
    </div>
    <p class="gallery-index-count" id="gallery-live-count" role="status" aria-live="polite">正在展示 {total} 项内容</p>
    <div class="gallery-grid" id="home-gallery">
      <div class="gallery-item" data-gallery-kind="work" data-reveal>
        <GalleryCard href="/software/usblinkmic/" title="USBLinkMic"
          description="把 Android 手机的麦克风连接到 Mac。真实产品，公开版本与技术限制都写清楚。"
          category="软件 / macOS + Android" meta={usb.statusBadge}
          image={usb.screenshot} tone="tool" index={0} transitionKey="work-usblinkmic" />
      </div>
      {posts.slice(0, 2).map((post, index) => (
        <div class="gallery-item" data-gallery-kind="writing" data-reveal>
          <GalleryCard href={'/posts/' + post.id + '/'} title={post.data.title}
            description={post.data.description} category={KIND_LABELS[post.data.kind]}
            meta={formatDate(post.data.pubDate) + ' · ' + getReadingTime(post.body)}
            tone={post.data.kind === 'thought' ? 'thinking' : post.data.kind}
            image={post.data.cover} index={index + 1} transitionKey={'article-' + post.id} />
        </div>
      ))}
      <div class="gallery-item" data-gallery-kind="work" data-reveal>
        <GalleryCard href="/software/habitbloom/" title="HabitBloom"
          description="从一张愿意每天打开的习惯卡片开始，探索 Widget 和本地交互的真实边界。"
          category="软件 / 个人原型" meta={habit.statusBadge}
          image={habit.screenshot} tone="tool" index={3} transitionKey="work-habitbloom" />
      </div>
      {posts.slice(2).map((post, index) => (
        <div class="gallery-item" data-gallery-kind="writing" data-reveal>
          <GalleryCard href={'/posts/' + post.id + '/'} title={post.data.title}
            description={post.data.description} category={KIND_LABELS[post.data.kind]}
            meta={formatDate(post.data.pubDate) + ' · ' + getReadingTime(post.body)}
            image={post.data.cover} tone={post.data.kind === 'thought' ? 'thinking' : post.data.kind}
            index={index + 4} transitionKey={'article-' + post.id} />
        </div>
      ))}
      {workbench.map((project, index) => (
        <div class="gallery-item" data-gallery-kind="work" data-reveal>
          <GalleryCard href={project.href} title={project.name} description={project.summary}
            category="工作台 / 项目实践" meta={project.status} tone="tool"
            index={index + 4 + posts.length} />
        </div>
      ))}
    </div>
    <div class="gallery-more-links">
      <a href="/software/">全部软件作品 <span aria-hidden="true">↗</span></a>
      <a href="/posts/">全部文章与手记 <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="shell gallery-outro" aria-labelledby="outro-title">
    <span class="gallery-outro-index">A NOTE FROM THE MAKER / XIN</span>
    <div>
      <h2 id="outro-title">好用，比看起来厉害更重要。</h2>
      <p>设计、开发、反复核对。这些作品未必完美，但每一个都尽量交代清楚：它解决什么问题，已经做到哪一步，还有哪些限制。</p>
    </div>
    <a href="/about/#contact">交流一个想法 <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>

<style>
  .gallery-index-count { font-size: 11px; color: var(--text-muted); margin: 0 0 15px; letter-spacing: .035em; }
  .gallery-more-links { display: flex; gap: 10px; flex-wrap: wrap; margin: 34px 0 0; }
  .gallery-more-links a { display: inline-flex; justify-content: space-between; align-items: center; gap: 28px; min-height: 44px; padding: 10px 15px; border: 1px solid var(--line); border-radius: 10px; font-size: 12px; font-weight: 650; background: var(--surface); }
  .gallery-more-links a:hover { border-color: var(--line-strong); color: var(--accent-contrast); }
  .gallery-outro { border-top: 1px solid var(--line); padding: clamp(35px,5vw,66px) 0; display: grid; grid-template-columns: .7fr 1.7fr auto; gap: 25px; align-items: start; }
  .gallery-outro-index { font-size: 10px; color: var(--text-muted); letter-spacing: .11em; font-weight: 700; }
  .gallery-outro h2 { font-size: clamp(24px,2.7vw,37px); margin-bottom: 12px; }
  .gallery-outro p { color: var(--text-secondary); font-size: 14px; max-width: 62ch; }
  .gallery-outro > a { padding: 10px 13px; border: 1px solid var(--line); border-radius: 9px; font-size: 12px; white-space: nowrap; }
  @media (max-width:900px) { .gallery-outro { grid-template-columns: 1fr; } .gallery-outro > a { justify-self:start; } }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-gallery-filter]')];
  const items = [...document.querySelectorAll<HTMLElement>('[data-gallery-kind]')];
  const liveCount = document.getElementById('gallery-live-count');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  function setGalleryFilter(category: string) {
    tabs.forEach((tab) => tab.setAttribute('aria-pressed', String(tab.dataset.galleryFilter === category)));
    let visible = 0;
    items.forEach((item, index) => {
      const show = category === 'all' || item.dataset.galleryKind === category;
      const wasHidden = item.hidden;
      item.hidden = !show;
      if (!show) return;
      visible++;
      if (wasHidden && !reduced.matches && typeof item.animate === 'function') {
        item.animate([{opacity:0,transform:'translateY(12px)'},{opacity:1,transform:'translateY(0)'}],
          {duration:300,delay:Math.min(index * 25,120),easing:'cubic-bezier(.2,.7,.2,1)'});
      }
    });
    if (liveCount) liveCount.textContent = '正在展示 ' + visible + ' 项内容';
  }
  tabs.forEach((tab) => tab.addEventListener('click', () => {
    const category = tab.dataset.galleryFilter || 'all';
    if ('startViewTransition' in document && !reduced.matches) {
      document.startViewTransition(() => setGalleryFilter(category));
    } else setGalleryFilter(category);
  }));
</script>
