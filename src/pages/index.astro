---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryCard from '../components/GalleryCard.astro';
import { getListedPosts, formatDate, getReadingTime, KIND_LABELS } from '../lib/posts';
import { SOFTWARE_PRODUCTS, WORKBENCH_PROJECTS } from '../lib/software';
import { siteConfig } from '../config';
const listedPosts = await getListedPosts();
const posts = listedPosts.slice(0, 12);
const usb = SOFTWARE_PRODUCTS[0];
const workbench = WORKBENCH_PROJECTS.slice(0, 4);
const total = SOFTWARE_PRODUCTS.length + posts.length + workbench.length;
---
<BaseLayout title="Xin 的作品集与工程手记" description={siteConfig.description} image={usb.screenshot}>
  <header class="shell gallery-hero" data-reveal>
    <div class="gallery-hero-topline">
      <span>MYZJX.COM · XIN</span>
      <span class="gallery-status-light">AI 应用工程 · 产品与全栈开发</span>
    </div>
    <h1>把真实问题，做成能用的软件。</h1>
    <p class="gallery-hero-description">专注 AI Agent 工具链、多模型网关治理与 macOS / iOS / Android 原生应用开发。这里收录已开源发布的 {SOFTWARE_PRODUCTS.length} 款代表软件、真实运行截图与 {listedPosts.length} 篇技术及产品复盘。</p>
    <div class="gallery-hero-bottom">
      <div class="gallery-hero-links">
        <a href="/software/">浏览软件作品 <span aria-hidden="true">↘</span></a>
        <a href="/posts/">技术与产品文章 <span aria-hidden="true">↘</span></a>
        <a href="/about/">关于 Xin <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="gallery-index-rule"></div>
  </header>

  <section class="shell gallery-section" id="explore" aria-labelledby="explore-title">
    <div class="gallery-section-heading">
      <div>
        <h2 id="explore-title">代表软件与实战文章</h2>
      </div>
      <div class="gallery-view-tabs" data-liquid-nav role="group" aria-label="筛选公开内容">
        <span class="liquid-nav-pill" aria-hidden="true"></span>
        <button type="button" data-gallery-filter="all" aria-pressed="true">全部</button>
        <button type="button" data-gallery-filter="work" aria-pressed="false">软件作品</button>
        <button type="button" data-gallery-filter="writing" aria-pressed="false">技术与产品文章</button>
      </div>
    </div>
    <p class="gallery-index-count" id="gallery-live-count" role="status" aria-live="polite">正在展示 {total} 项内容</p>
    <div class="gallery-grid" id="home-gallery">
      {SOFTWARE_PRODUCTS.map((product, index) => (
        <div class="gallery-item" data-gallery-kind="work" data-reveal>
          <GalleryCard href={`/software/${product.slug}/`} title={product.name}
            description={product.tagline + '。' + product.availabilitySummary}
            category={'软件 / ' + product.platformsLabel} meta={product.statusBadge}
            image={product.screenshot} icon={product.icon} badge={product.latestVersion}
            tone="tool" index={index} transitionKey={'work-' + product.slug} />
        </div>
      ))}
      {posts.map((post, index) => (
        <div class="gallery-item" data-gallery-kind="writing" data-reveal>
          <GalleryCard href={'/posts/' + post.id + '/'} title={post.data.title}
            description={post.data.description} category={KIND_LABELS[post.data.kind]}
            meta={formatDate(post.data.pubDate) + ' · ' + getReadingTime(post.body)}
            image={post.data.cover} video={post.data.video} videoPoster={post.data.videoPoster} tone={post.data.kind === 'thought' ? 'thinking' : post.data.kind}
            index={index + SOFTWARE_PRODUCTS.length} transitionKey={'article-' + post.id} />
        </div>
      ))}
      {workbench.map((project, index) => (
        <div class="gallery-item" data-gallery-kind="work" data-reveal>
          <GalleryCard href={project.href} title={project.name} description={project.summary}
            category="工作台 / 项目实践" meta={project.status} tone="tool"
            index={index + SOFTWARE_PRODUCTS.length + posts.length} />
        </div>
      ))}
    </div>
    <div class="gallery-more-links">
      <a href="/software/">查看全部 {SOFTWARE_PRODUCTS.length} 款软件作品 <span aria-hidden="true">↗</span></a>
      <a href="/posts/">阅读全部 {listedPosts.length} 篇实战文章 <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="shell gallery-outro" aria-labelledby="outro-title">
    <span class="gallery-outro-index">OPEN SOURCE &amp; CONTACT</span>
    <div>
      <h2 id="outro-title">源码、安装包与复盘记录全部公开可查。</h2>
      <p>所有项目均在 GitHub 提供 Release 构建产物、SHA-256 校验或完整源码工程。欢迎进一步交流 AI 应用工程与产品实践。</p>
    </div>
    <div class="gallery-outro-actions">
      <a href="/about/#contact">关于与联系 <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
