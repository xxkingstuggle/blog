---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleRow from '../components/ArticleRow.astro';
import { getListedPosts, formatDate, getReadingTime, KIND_LABELS } from '../lib/posts';
import { SOFTWARE_PRODUCTS } from '../lib/software';
import { siteConfig } from '../config';

const posts = await getListedPosts();
const featuredEssays = posts.slice(0, 3);
const usbLinkMic = SOFTWARE_PRODUCTS[0];
---

<BaseLayout
	title={siteConfig.name}
	description={siteConfig.description}
>
	<!-- 1. Brand & Studio Hero -->
	<section class="brand-hero" aria-labelledby="home-hero-heading">
		<div class="shell brand-hero-grid">
			<div class="brand-hero-copy">
				<div class="section-kicker">
					<span class="kicker-dot" aria-hidden="true"></span>
					<span>Xin · 个人品牌与原生软件工作台</span>
				</div>
				<h1 id="home-hero-heading">
					做真正解决具体问题的软件，也把工程取舍诚实写下来。
				</h1>
				<p class="brand-hero-lead">
					你好，我是 Xin。我习惯从自己日常工作台上的真实摩擦出发——无论是让 Android 手机直接充当 Mac 的低延迟麦克风与双向网卡，还是在免费签名环境下跑通多端同步的习惯卡片应用。这里提供我的软件下载、架构拆解与思考手记。
				</p>
				<div class="brand-hero-actions">
					<a class="btn-primary" href="/software/">
						<span>浏览软件与获取方式</span>
					</a>
					<a class="btn-secondary" href="/posts/">
						<span>阅读工程与思考手记</span>
					</a>
				</div>
				<div class="brand-hero-facts" aria-label="工作台核心信息">
					<div class="hero-fact-item">
						<strong>原生与跨端工具</strong>
						<span>专注 macOS、iOS 与 Android 之间的低摩擦协同。</span>
					</div>
					<div class="hero-fact-item">
						<strong>真实版本可验证</strong>
						<span>USBLinkMic v4.0.8 提供 DMG 与 APK 公开下载及校验。</span>
					</div>
					<div class="hero-fact-item">
						<strong>完整工程复盘</strong>
						<span>每款软件均配有从踩坑、协议设计到验证的深度长文。</span>
					</div>
				</div>
			</div>

			<aside class="workbench-stage" aria-label="当前代表软件一览">
				<div class="workbench-stage-header">
					<div class="workbench-stage-title">
						<span class="kicker-dot" aria-hidden="true"></span>
						<span>代表软件作品</span>
					</div>
					<span class="workbench-stage-sub">myzjx.com/software</span>
				</div>

				{SOFTWARE_PRODUCTS.map((product) => (
					<div class="workbench-product-card">
						<a class="workbench-app-icon" href={`/software/${product.slug}/`} aria-label={`查看 ${product.name} 详情`}>
							<Image src={product.icon} alt={`${product.name} 图标`} width={112} height={112} />
						</a>
						<div class="workbench-product-body">
							<div class="workbench-product-head">
								<h2><a href={`/software/${product.slug}/`}>{product.name}</a></h2>
								<span class="status-pill" data-tone={product.statusTone}>{product.statusBadge}</span>
							</div>
							<p>{product.tagline}</p>
							<div class="workbench-product-foot">
								<span class="platform-pill">{product.platformsLabel}</span>
								<div class="workbench-inline-links">
									<a href={`/software/${product.slug}/`}>产品详情</a>
									<a href={`/posts/${product.articleSlug}/`}>工程手记</a>
								</div>
							</div>
						</div>
					</div>
				))}
			</aside>
		</div>
	</section>

	<!-- 2. Software Showcase Section -->
	<section class="home-software-section" id="projects" aria-labelledby="software-section-heading">
		<div class="shell">
			<div class="section-header-bar">
				<div>
					<div class="section-kicker">
						<span class="kicker-dot" aria-hidden="true"></span>
						<span>软件与工具官网</span>
					</div>
					<h2 id="software-section-heading">从具体场景长出来的个人软件</h2>
					<p>不堆砌无关特性，每款软件只把一个高频痛点打磨到顺手可靠。点击进入产品页即可查看系统要求、工作流程与下载方式。</p>
				</div>
				<a class="btn-secondary" href="/software/">查看全部软件对比</a>
			</div>

			<div class="software-showcase-stack">
				{SOFTWARE_PRODUCTS.map((product) => (
					<article class="software-flagship-card" aria-labelledby={`product-title-${product.slug}`}>
						<div class="software-flagship-info">
							<div class="software-card-top">
								<div class="software-card-icon">
									<Image src={product.icon} alt={`${product.name} 应用图标`} width={112} height={112} />
								</div>
								<div class="software-card-titles">
									<h3 id={`product-title-${product.slug}`}>
										<a href={`/software/${product.slug}/`}>{product.name}</a>
									</h3>
									<span>{product.category}</span>
								</div>
								<div class="software-card-badges">
									<span class="status-pill" data-tone={product.statusTone}>{product.statusBadge}</span>
									<span class="platform-pill">{product.platformsLabel}</span>
								</div>
							</div>

							<p class="software-card-headline">{product.headline}</p>
							<p class="software-card-summary">{product.summary}</p>

							<ul class="software-feature-bullets">
								{product.highlights.slice(0, 3).map((item) => (
									<li>
										<strong>{item.title}：</strong>
										<span>{item.body}</span>
									</li>
								))}
							</ul>

							<div class="software-card-actions">
								<a class="btn-primary" href={`/software/${product.slug}/`}>
									<span>{product.downloads.length > 0 ? `进入 ${product.name} 产品页与下载` : `了解 ${product.name} 设计与架构`}</span>
								</a>
								{product.downloads[0] && (
									<a class="btn-secondary" href={product.downloads[0].url} target="_blank" rel="noopener noreferrer">
										<span>直接下载 {product.downloads[0].format} ({product.downloads[0].version})</span>
									</a>
								)}
								<a class="btn-secondary" href={`/posts/${product.articleSlug}/`}>
									<span>阅读开发复盘</span>
								</a>
							</div>
						</div>

						<div class="software-flagship-visual">
							<a class="software-visual-frame" href={`/software/${product.slug}/`} aria-label={`查看 ${product.name} 界面与详情`}>
								<Image
									src={product.screenshot}
									alt={product.screenshotAlt}
									width={960}
									height={640}
									loading="lazy"
								/>
							</a>
							<p class="software-visual-caption">{product.screenshotCaption}</p>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- 3. Featured Engineering & Thought Essays -->
	<section class="home-journal-section" id="latest" aria-labelledby="journal-section-heading">
		<div class="shell">
			<div class="section-header-bar">
				<div>
					<div class="section-kicker">
						<span class="kicker-dot" aria-hidden="true"></span>
						<span>工程复盘与思考手记</span>
					</div>
					<h2 id="journal-section-heading">软件背后的架构取舍与日常思考</h2>
					<p>不仅交付可用的工具，也记录真实开发过程中的音频缓冲计算、免费签名突围方案、多 Agent 协作闭环，以及工作之外的自省。</p>
				</div>
				<a class="btn-secondary" href="/posts/">浏览全部 {posts.length} 篇文章</a>
			</div>

			<div class="journal-featured-grid">
				{featuredEssays.map((post) => (
					<a class="journal-pillar-card" href={`/posts/${post.id}/`}>
						<div>
							<span class="article-row-kicker" data-kind={post.data.kind}>
								{post.data.kicker || KIND_LABELS[post.data.kind]}
							</span>
							<h3>{post.data.title}</h3>
							<p>{post.data.description}</p>
						</div>
						<div class="journal-pillar-meta">
							<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
							<span>{getReadingTime(post.body)}</span>
						</div>
					</a>
				))}
			</div>

			<div aria-label="全部近期文章列表">
				{posts.map((post, index) => (
					<ArticleRow post={post} index={index} />
				))}
			</div>
		</div>
	</section>

	<!-- 4. Brand Closing & Direct Access -->
	<section class="software-section" style="border-bottom: 0;" aria-labelledby="closing-heading">
		<div class="shell">
			<div class="related-article-banner">
				<div>
					<div class="section-kicker">
						<span class="kicker-dot" aria-hidden="true"></span>
						<span>获取软件与持续关注</span>
					</div>
					<h3 id="closing-heading">直接体验软件，或通过 RSS 订阅后续更新</h3>
					<p>
						{usbLinkMic.name} {usbLinkMic.latestVersion} 已提供 macOS DMG 与 Android APK 下载；新的工程实践与思考文章会同步更新在主站与 RSS 源中。
					</p>
				</div>
				<div class="brand-hero-actions" style="margin-bottom: 0;">
					<a class="btn-primary" href="/software/usblinkmic/">获取 USBLinkMic {usbLinkMic.latestVersion}</a>
					<a class="btn-secondary" href="/rss.xml">订阅 RSS</a>
					<a class="btn-secondary" href="/about/">关于 Xin</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
