---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import '../../../styles/iteration.css';
import '../../../styles/iteration-editorial.css';
---

<AdminLayout title="个人迭代系统" description="仅管理员可访问的个人迭代画板与 Markdown 资料工作台。" context="个人迭代系统" canonicalPath="/admin/iteration/" bodyClass="iteration-body">
  <main id="main-content" class="iteration-page">
    <div class="iteration-top">
      <p class="iteration-kicker">MYZJX <span class="iteration-kicker-separator">/</span> PRIVATE WORKSPACE <span class="iteration-kicker-separator">/</span> 01</p>
      <div class="iteration-actions">
        <a class="iteration-link" href="/admin/">返回管理后台 <span aria-hidden="true">↗</span></a>
        <button id="iteration-reload" class="iteration-button secondary" type="button">↻ 重新同步</button>
      </div>
    </div>

    <section class="iteration-goal" aria-labelledby="iteration-hero-title">
      <div class="iteration-hero-copy">
        <p class="iteration-hero-overline"><span class="iteration-hero-overline-mark" aria-hidden="true"></span> A MORE INTENTIONAL LIFE</p>
        <h1 id="iteration-hero-title" class="iteration-hero-index">个人迭代系统 <span>— a work in progress.</span></h1>
        <h2>把日子过成<br /><em>自己想要的样子。</em></h2>
        <span class="iteration-hero-lead">从一个真实的问题开始。想办法，去行动，带着结果回来。<br class="iteration-desktop-only" />每一次尝试，都让下一步更清楚一点。</span>
        <a href="#iteration-explorer-title" class="iteration-hero-action">
          <span>打开我的迭代记录</span>
          <span class="iteration-hero-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="iteration-hero-art" aria-hidden="true">
        <div class="iteration-hero-disc">
          <span class="iteration-hero-disc-ring iteration-hero-disc-ring-one"></span>
          <span class="iteration-hero-disc-ring iteration-hero-disc-ring-two"></span>
          <span class="iteration-hero-disc-mark iteration-hero-disc-mark-one"></span>
          <span class="iteration-hero-disc-mark iteration-hero-disc-mark-two"></span>
          <span class="iteration-hero-disc-mark iteration-hero-disc-mark-three"></span>
          <span class="iteration-hero-disc-mark iteration-hero-disc-mark-four"></span>
          <span class="iteration-hero-disc-center">↺</span>
        </div>
        <span class="iteration-hero-art-caption">REFLECT <span>·</span> REFINE <span>·</span> REPEAT</span>
      </div>
    </section>

    <div class="iteration-state" id="iteration-state" role="status" aria-live="polite">正在验证身份并读取私有资料…</div>

    <section class="iteration-explorer" aria-labelledby="iteration-explorer-title">
      <div class="iteration-explorer-head">
        <div>
          <p class="iteration-eyebrow">01 / YOUR WORK IN PROGRESS</p>
          <h2 id="iteration-explorer-title">正在推进的事情<span class="iteration-headline-period">.</span></h2>
          <p class="iteration-explorer-intro">挑一件事，看看走到了哪一步。点开问题，沿着四步圆盘继续往前。</p>
        </div>
        <span class="iteration-pill" id="iteration-progress-count" aria-live="polite">等待同步</span>
      </div>
      <div class="iteration-explorer-controls">
        <label for="iteration-search" class="iteration-search-wrap">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="11" cy="11" r="7.25"></circle><path d="m16.5 16.5 4.5 4.5"></path></svg>
          <span class="sr-only">搜索问题</span>
          <input id="iteration-search" type="search" placeholder="搜索编号、问题或进度…" autocomplete="off" />
        </label>
        <div class="iteration-filters" role="group" aria-label="按真实阶段筛选问题">
          <button class="is-selected" data-iteration-filter="all" aria-pressed="true" type="button">全部 <span class="iteration-filter-count"></span></button>
          <button data-iteration-filter="问题" aria-pressed="false" type="button">问题 <span class="iteration-filter-count"></span></button>
          <button data-iteration-filter="办法" aria-pressed="false" type="button">办法 <span class="iteration-filter-count"></span></button>
          <button data-iteration-filter="行动" aria-pressed="false" type="button">行动 <span class="iteration-filter-count"></span></button>
          <button data-iteration-filter="反馈" aria-pressed="false" type="button">反馈 <span class="iteration-filter-count"></span></button>
          <button data-iteration-filter="unknown" aria-pressed="false" type="button">待标注 <span class="iteration-filter-count"></span></button>
        </div>
      </div>
      <div id="iteration-progress-list" class="iteration-progress-list" aria-live="off">
        <p class="iteration-muted">正在从私有 GitHub 仓库读取问题和阶段…</p>
      </div>
      <p class="iteration-explorer-footnote">圆盘突出的是 MD 中记录的真实阶段；点圆盘其他节点只是查看，不会伪造行动或修改进度。</p>
    </section>


    <details id="iteration-records" class="iteration-records">
      <summary class="iteration-records-summary">
        <span class="iteration-records-summary-copy">
          <span class="iteration-eyebrow">02 / YOUR ARCHIVE</span>
          <strong>把经验留给下一次自己<span class="iteration-headline-period">.</span></strong>
          <small>规则、方法和长期记录，点开后可以直接编辑并保存到 GitHub。</small>
        </span>
        <span class="iteration-records-toggle"><span>展开编辑器</span><span class="iteration-records-toggle-arrow" aria-hidden="true">↗</span></span>
      </summary>
    <section class="iteration-panel iteration-editor-panel" aria-labelledby="iteration-editor-heading">
      <div class="iteration-panel-heading">
        <div>
          <p class="iteration-eyebrow">EDIT / SOURCE OF TRUTH</p>
          <h2 id="iteration-editor-heading">Markdown 工作台<span class="iteration-headline-period">.</span></h2>
          <p class="iteration-muted">不是每次都要重新开始。修改这里，保存到私有 GitHub，让经验留得下来。</p>
        </div>
        <a class="iteration-link" id="iteration-github-link" href="https://github.com" target="_blank" rel="noopener noreferrer" hidden>在 GitHub 查看历史 ↗</a>
      </div>
      <div class="iteration-doc-tabs" id="iteration-doc-tabs" aria-label="选择文档">
        <button type="button" data-file="iteration-current.md" class="is-selected">当前进度</button>
        <button type="button" data-file="personal-iteration-system.md">系统规则</button>
        <button type="button" data-file="iteration-methods.md">方法历史</button>
        <button type="button" data-file="START-HERE.md">交接说明</button>
      </div>
      <label class="iteration-editor-label" for="iteration-editor">Markdown 原文</label>
      <textarea id="iteration-editor" class="iteration-textarea" rows="18" spellcheck="false" disabled placeholder="私有资料尚未读取。"></textarea>
      <div class="iteration-editor-footer">
        <p id="iteration-edit-status" class="iteration-muted" role="status" aria-live="polite">尚未连接仓库</p>
        <div class="iteration-actions">
          <button id="iteration-reset" type="button" class="iteration-button secondary" disabled>放弃当前修改</button>
          <button id="iteration-save" type="button" class="iteration-button" disabled>保存到 GitHub</button>
        </div>
      </div>
    </section>
    </details>
    <footer class="iteration-footer"><span>MYZJX / THE ITERATION PROJECT</span><span>真实发生的事，才值得被记住。私人记录仅通过受保护接口读取。</span></footer>
  </main>
</AdminLayout>

<script>
import { mountIssueBoard } from '../../../scripts/iteration-wheel';
interface IterationFile { content:string; sha:string }
interface IterationFiles { [file:string]:IterationFile }
interface IterationPayload { files:IterationFiles; repository:string; branch:string; directory:string }
const editor=document.querySelector<HTMLTextAreaElement>('#iteration-editor')!;
const state=document.querySelector<HTMLElement>('#iteration-state')!;
const editStatus=document.querySelector<HTMLElement>('#iteration-edit-status')!;
const saveBtn=document.querySelector<HTMLButtonElement>('#iteration-save')!;
const resetBtn=document.querySelector<HTMLButtonElement>('#iteration-reset')!;
const tabs=[...document.querySelectorAll<HTMLButtonElement>('#iteration-doc-tabs button')];
let payload:IterationPayload|null=null;
let csrfToken='';
let chosen='iteration-current.md';
let saving=false;
function setState(message:string, kind:string='loading'){state.textContent=message;state.dataset.status=kind;}
function selectedDoc(){return payload?.files[chosen];}
function updateEditor(){
  const file=selectedDoc();
  editor.disabled=!file||saving;
  editor.value=file?.content??'';
  tabs.forEach((x)=>x.classList.toggle('is-selected',x.dataset.file===chosen));
  markDirty();
}
function markDirty(){
  const file=selectedDoc();
  const dirty=!!file&&editor.value!==file.content;
  saveBtn.disabled=!file||!dirty||saving;
  resetBtn.disabled=!file||!dirty||saving;
  editStatus.textContent=saving?'正在保存到 GitHub…':(!file?'尚未连接私有仓库':dirty?'有尚未保存的修改':'已与仓库同步（本页未修改）');
}
const issueBoard = mountIssueBoard(document.querySelector<HTMLElement>('#iteration-progress-list')!);
function renderProgress(markdown: string) { issueBoard.render(markdown); }
async function refresh(){
  if(editor.value!==selectedDoc()?.content&&selectedDoc()&&!confirm('有未保存的修改。确认放弃并重新读取吗？'))return;
  setState('正在读取 GitHub 私有仓库…');
  try{
    const session=await fetch('/api/admin/session',{credentials:'same-origin',cache:'no-store'});
    if(session.status===401||session.status===403){location.href='/login/';return;}
    if(!session.ok)throw new Error('管理员会话获取失败 ('+session.status+')');
    const auth=await session.json();csrfToken=auth.csrfToken;
    const response=await fetch('/api/admin/iteration/files',{credentials:'same-origin',cache:'no-store'});
    const result=await response.json();
    if(!response.ok)throw new Error(result.message||result.error||'读取失败 ('+response.status+')');
    payload=result as IterationPayload;
    const link=document.querySelector<HTMLAnchorElement>('#iteration-github-link')!;
    link.href='https://github.com/'+encodeURIComponent(payload.repository.split('/')[0])+'/'+encodeURIComponent(payload.repository.split('/')[1])+'/tree/'+encodeURIComponent(payload.branch)+(payload.directory?'/'+payload.directory.split('/').map(encodeURIComponent).join('/'): '');
    link.hidden=false;
    renderProgress(payload.files['iteration-current.md']?.content||'');
    updateEditor();
    setState('已连接私有仓库 · '+payload.repository+' · '+payload.branch,'ready');
  }catch(e){
    payload=null;editor.value='';editor.disabled=true;
    renderProgress('');markDirty();
    setState('尚未连接：'+(e instanceof Error?e.message:String(e)),'error');
  }
}
tabs.forEach((button)=>button.addEventListener('click',()=>{
  if(chosen===button.dataset.file)return;
  if(selectedDoc()&&editor.value!==selectedDoc()?.content&&!confirm('有未保存的修改。确认切换文档并放弃修改吗？'))return;
  chosen=button.dataset.file||'iteration-current.md';updateEditor();
}));
editor.addEventListener('input',markDirty);
resetBtn.addEventListener('click',updateEditor);
document.querySelector('#iteration-reload')?.addEventListener('click',refresh);
saveBtn.addEventListener('click',async()=>{
  const file=selectedDoc();if(!file||saving||!csrfToken)return;
  saving=true;markDirty();
  try{
    const response=await fetch('/api/admin/iteration/files/'+encodeURIComponent(chosen),{
      method:'PUT',credentials:'same-origin',headers:{'Content-Type':'application/json','X-CSRF-Token':csrfToken},
      body:JSON.stringify({content:editor.value,sha:file.sha})
    });
    const result=await response.json();
    if(!response.ok)throw new Error(result.message||result.error||'保存失败 ('+response.status+')');
    file.sha=result.sha;file.content=editor.value;
    if(chosen==='iteration-current.md')renderProgress(file.content);
    setState('已保存到 GitHub · commit '+String(result.commitSha).slice(0,8),'ready');
  }catch(e){setState('保存失败：'+(e instanceof Error?e.message:String(e)),'error');}
  finally{saving=false;markDirty();}
});
refresh();
</script>