---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config';
import { SOFTWARE_PRODUCTS } from '../lib/software';
---

<BaseLayout title="关于 Xin" description="我是 Xin，从具体问题出发做软件，负责需求判断、集成与验收，也把 AI 和第三方贡献说清楚。">
	<header class="shell page-heading" data-reveal>
		<div class="section-kicker">
			<span class="kicker-dot" aria-hidden="true"></span>
			<span>ABOUT XIN / 关于我</span>
		</div>
		<h1>你好，我是 Xin</h1>
		<p>我从日常遇到的具体问题出发，借助 AI 参与软件开发，再把各部分集成起来，用构建、测试和实际运行证据检查结果。</p>
	</header>

	<section class="shell about-layout">
		<div class="article-prose about-prose">
			<h2>我负责什么</h2>
			<p>
				我先判断要解决的问题、写清范围和约束，再把任务拆成可以检查的部分。AI 工具会参与代码实现、资料整理或审查；我负责看改动、处理系统间的集成，并根据项目条件运行构建、测试或设备验证。工具报告“完成”只是线索，能支持到哪一步，就按实际证据写到哪一步。
			</p>
			<p>
				<a href="/software/usblinkmic/">USBLinkMic</a> 展示的是 Android 与 Mac 之间的音频、网络和系统权限如何接到同一个使用流程里。BlackHole、Gnirehtet 等第三方组件各自保留来源与许可；我不把它们说成自己从零实现。完整的机型与长期稳定性仍有未验证项。
			</p>
			<p>
				<a href="/posts/habitbloom-habit-tracker/">HabitBloom</a> 则体现另一类取舍：主 App 使用本地数据，Widget 可通过 HTTP 远端快照读取和回并部分状态。它不是实时同步服务，也没有完整的离线冲突处理；项目目前没有公开安装包，源码为私有。
			</p>

			<h2>我怎样与 AI 协作</h2>
			<p>
				我会先定义任务边界和验收依据，再让 AI 工具协助实现或独立检查。之后我核对实际差异和项目输出；遇到平台 API、权限或设备行为时，仍以编译器、测试和真实运行结果为准。<a href="/posts/lightweight-multi-agent-coding-loop/">这篇多 Agent 工程记录</a>保留了当时的协作方式与限制，它是一份有日期的实践记录，不代表今天每个工具入口都没变化。
			</p>
			<p>
				公开案例会尽量标明哪些判断和集成由我负责、哪些部分有 AI 或第三方组件参与，以及证据覆盖了什么环境。源码或安装包不能公开时，也会直接说明，不给访客指向私有仓库。
			</p>

			<h2 id="contact">联系与订阅</h2>
			<p>
				如果你想讨论桌面与移动端集成、个人软件的工程取舍，或 AI 协作开发，可以从公开的 GitHub 页面联系我；RSS 可以订阅新文章。
			</p>
			<div class="brand-hero-actions" style="margin-top: 20px;">
				<a class="btn-primary" href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GitHub (@xxkingstuggle)</a>
				<a class="btn-secondary" href="/rss.xml">RSS 订阅源</a>
			</div>
		</div>

		<aside class="about-sidebar" aria-label="代表软件与快捷导航">
			<div class="about-card">
				<div class="section-kicker" style="margin-bottom: 10px;">
					<span class="kicker-dot" aria-hidden="true"></span>
					<span>当前维护的软件</span>
				</div>
				<div style="display: grid; gap: 14px;">
					{SOFTWARE_PRODUCTS.map((product) => (
						<a class="workbench-product-card" href={`/software/${product.slug}/`} style="padding: 12px;">
							<div class="workbench-app-icon" style="width: 44px; height: 44px;">
								<Image src={product.icon} alt={product.name} width={88} height={88} />
							</div>
							<div>
								<strong style="display: block; font-size: 14.5px; color: var(--text);">{product.name}</strong>
								<span style="display: block; font-size: 12px; color: var(--text-muted); margin-top: 2px;">{product.statusBadge}</span>
							</div>
						</a>
					))}
				</div>
			</div>

			<div class="about-card">
				<strong style="display: block; font-size: 14px; margin-bottom: 10px;">站点栏目导航</strong>
				<nav class="about-quick-links" aria-label="快捷入口">
					<a href="/software/"><span>软件与工具总览</span><span>→</span></a>
					<a href="/posts/"><span>全部文章与手记</span><span>→</span></a>
					<a href="/archive/"><span>时间归档</span><span>→</span></a>
					<a href="/tags/"><span>标签索引</span><span>→</span></a>
					<a href="https://github.com/xxkingstuggle/blog" target="_blank" rel="noopener noreferrer"><span>本站开源仓库</span><span>↗</span></a>
				</nav>
			</div>
		</aside>
	</section>
</BaseLayout>

<style>
	.about-layout {
		display: grid;
		grid-template-columns: minmax(0, 700px) minmax(280px, 360px);
		justify-content: space-between;
		gap: var(--space-12);
		padding: var(--space-12) 0 var(--space-16);
	}
	.about-prose {
		margin: 0;
	}
	.about-prose h2:first-child {
		margin-top: 0;
		padding-top: 0;
		border-top: 0;
	}
	.about-sidebar {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		align-self: start;
	}
	.about-card {
		padding: var(--space-6);
		border-radius: var(--radius-lg);
		background: var(--surface);
		border: 1px solid var(--line);
	}
	.about-quick-links {
		display: grid;
		gap: 8px;
	}
	.about-quick-links a {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 8px 10px;
		border-radius: var(--radius-xs);
		font-size: 13.5px;
		color: var(--text-secondary);
		background: var(--bg);
	}
	.about-quick-links a:hover {
		color: var(--text);
		background: var(--surface-subtle);
	}
	@media (max-width: 920px) {
		.about-layout {
			grid-template-columns: 1fr;
		}
	}
</style>
