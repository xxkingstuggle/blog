{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "blog-production",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-04",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/auth/*",
			"/admin/*",
			"/media/*",
			"/__health",
			"/__build.json"
		]
	},
	"triggers": {
		"crons": ["*/1 * * * *"]
	},
	"ratelimits": [
		{
			"name": "COMMENTS_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "blog-production",
			"database_id": "e6e5331e-391b-43d0-8c75-e19c019d37ae"
		}
	],
	"vars": {
		"ENVIRONMENT": "production",
		"PUBLIC_ORIGIN": "https://xingx.cc.cd",
		"CN_ORIGIN": "https://cn.xingx.cc.cd",
		"ACCESS_ISSUER": "https://xingx.cloudflareaccess.com",
		"ACCESS_AUDIENCE": "REPLACE_WITH_PRODUCTION_ACCESS_AUD",
		"ADMIN_EMAILS": "REPLACE_WITH_ADMIN_EMAIL",
		"GITHUB_APP_ID": "4828979",
		"GITHUB_INSTALLATION_ID": "159019368",
		"GITHUB_CLIENT_ID": "Iv23lidzExMwZKg1894w",
		"ADMIN_GITHUB_LOGINS": "xxkingstuggle",
		"GITHUB_OWNER": "xxkingstuggle",
		"GITHUB_REPO": "blog",
		"GITHUB_BRANCH": "main",
		"ORIGIN_BUILD_URL": "https://xingx.cc.cd/__build.json",
		"CN_HEALTH_URL": "https://cn.xingx.cc.cd/__health",
		"CF_RULE_API_URL": "REPLACE_WITH_SINGLE_REDIRECT_RULE_API_URL"
	},
	"env": {
		"staging": {
			"name": "blog-staging",
			"ratelimits": [
				{
					"name": "COMMENTS_RATE_LIMIT",
					"namespace_id": "1002",
					"simple": { "limit": 5, "period": 60 }
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "blog-staging",
					"database_id": "1b33395b-4b11-440f-bd75-8d829068c23b"
				}
			],
			"vars": {
				"ENVIRONMENT": "staging",
				"PUBLIC_ORIGIN": "https://blog-staging.guozhongeba.workers.dev",
				"CN_ORIGIN": "https://cn-staging.xingx.cc.cd",
				"ACCESS_ISSUER": "https://xingx-staging.cloudflareaccess.com",
				"ACCESS_AUDIENCE": "REPLACE_WITH_STAGING_ACCESS_AUD",
				"ADMIN_EMAILS": "REPLACE_WITH_ADMIN_EMAIL",
				"GITHUB_APP_ID": "4828979",
				"GITHUB_INSTALLATION_ID": "159019368",
				"GITHUB_CLIENT_ID": "Iv23lidzExMwZKg1894w",
				"ADMIN_GITHUB_LOGINS": "xxkingstuggle",
				"GITHUB_OWNER": "xxkingstuggle",
				"GITHUB_REPO": "blog",
				"GITHUB_BRANCH": "cms-staging",
				"ORIGIN_BUILD_URL": "https://blog-staging.guozhongeba.workers.dev/__build.json",
				"CN_HEALTH_URL": "https://cn-staging.xingx.cc.cd/__health",
				"CF_RULE_API_URL": "REPLACE_WITH_STAGING_SINGLE_REDIRECT_RULE_API_URL"
			}
		}
	}
}
